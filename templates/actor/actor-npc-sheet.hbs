{{!-- ApplicationV2 renders this part straight into `.window-content`, which is
itself the sheet's <form> element — hence no <form> wrapper here. --}}
  <div class="sheet-main flexcol">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}" height="100" width="100"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name"/></h1>
      {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
      use both the "grid" and "grid-Ncol" class where "N" can be any number
      from 1 to 12 and will create that number of columns.  --}}
      <div class="resources flexrow">

        {{!-- "flex-group-center" is also defined in the _grid.scss file
        and it will add a small amount of padding, a border, and will
        center all of its child elements content and text. --}}
        <div class="resource flex-group-center">
          <label for="system.cr" class="resource-label">CR / XP</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.cr" value="{{system.cr}}" data-dtype="Number"/>
            <span> / </span>
            <input type="text" disabled="true" name="system.xp" value="{{system.xp}}" data-dtype="Number"/>
          </div>
        </div>

      </div>
    </div>
  </header>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Biography Tab --}}
    <div class="tab biography {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
      {{!-- Plain textarea instead of the ProseMirror editor helper: the
      editor requires an explicit click into an edit mode before typing,
      which is unnecessary friction for a simple freetext notes field. --}}
      <textarea name="system.biography" class="biography-textarea" placeholder="{{localize 'TNO.BiographyPlaceholder'}}">{{system.biography}}</textarea>
    </div>

    {{!-- Owned Items Tab --}}
    <div class="tab items {{tabs.items.cssClass}}" data-group="primary" data-tab="items">
       {{> "systems/tno/templates/actor/parts/actor-items.hbs"}}
    </div>

  </section>

  </div>

  {{!-- Sheet Tab Navigation, docked as a vertical icon rail along the right
  edge, mirroring the reference dnd5e sheet's tab layout. --}}
  <nav class="sheet-tabs tabs tabs-right" data-group="primary">
    {{!-- Tab set and default tab are declared in actor-sheet.mjs (static TABS);
    NPCs drop the "basics" tab there. --}}
    {{#each tabs as |tab|}}
    <a class="item {{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}"><i class="{{tab.icon}}"></i><span class="tab-label">{{localize tab.label}}</span></a>
    {{/each}}
  </nav>

