{{> 'systems/tno/templates/item/parts/item-gear-summary.hbs' showClose=true}}

{{!-- Only actions backed by stored state. A weapon's attack is the one thing
      the card is opened for, so it takes the full width above the rest; every
      other item makes editing the primary action instead. --}}
<footer class='item-popover-actions' aria-label='{{localize "TNO.Item.Overview.Actions"}}'>
  {{#if canWeaponCheck}}
    <button type='button' class='primary wide' data-popover-action='weapon-check'
            title='{{localize "TNO.Item.Overview.WeaponCheckHint"}}'>
      <i class='fa-solid fa-dice-d20' aria-hidden='true'></i>{{localize 'TNO.Item.Overview.WeaponCheck'}}
    </button>
  {{/if}}
  <div class='item-popover-actions-row'>
    <button type='button' data-popover-action='post'>
      <i class='fa-solid fa-message' aria-hidden='true'></i>{{localize 'TNO.Item.Overview.Post'}}
    </button>
    {{#if canEdit}}
      <button type='button' class='{{#unless canWeaponCheck}}primary{{/unless}}' data-popover-action='edit'>
        <i class='fa-solid fa-pen' aria-hidden='true'></i>{{localize 'TNO.Item.Popover.Edit'}}
      </button>
      <span class='spacer'></span>
      <button type='button' class='danger' data-popover-action='delete' {{#unless canDelete}}disabled title='{{localize "TNO.Item.DeleteWornHint"}}'{{/unless}}>
        <i class='fa-solid fa-trash' aria-hidden='true'></i>{{localize 'TNO.Item.Delete'}}
      </button>
    {{/if}}
  </div>
</footer>
