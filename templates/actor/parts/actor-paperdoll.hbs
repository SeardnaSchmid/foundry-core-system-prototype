{{!-- Paper doll: the Unterkleidung as a base layer above four zone rows,
mirroring the Rüstungen table's hit locations (Kopf, Torso, Arme, Beine).

An empty row is a drop target and nothing else: a piece is worn by dragging it
from the carry grid onto its zone (see `_onDrop`). Clicking one used to offer to
author a piece on the spot, which conjured gear out of an empty doll — wearing
something is a state change on gear already in hand.

Three quarters of the row past the figure are the worn zones, the last quarter
the zero-slot pocket beside them. The zone rows never needed the full width —
each is a label and three short read-outs — and the column that buys is the only
place on this tab tall enough to list the loose items downwards instead of
cramming them across a strip. `has-loose` is dropped when there is nothing
loose, so the rows take the width back rather than sitting beside an empty
box. --}}
<div class='paperdoll card{{#if slotGrid.trinkets.length}} has-loose{{/if}}'>

  {{!-- The viewBox is cropped to the drawing's actual bounds (x 22-98,
  y 4-160, plus a stroke's worth of margin) rather than a round 120x178 canvas,
  so the figure fills its box instead of floating in dead space. --}}
  <svg class='paperdoll-figure' viewBox='19 1 82 162' role='img'
       aria-label='{{localize "TNO.Armor.FigureAlt"}}'>
    <title>{{localize 'TNO.Armor.Zones'}}</title>
    {{!-- Three paint states, decided in the sheet: `bare` (grey — nothing on
    this location), `suited` (pale green — covered by the Unterkleidung alone)
    and `filled` (green — a zone addon is worn). --}}
    {{#each paperdoll.zones as |z|}}
      {{#ifEquals z.zone 'head'}}
        <circle class='zone zone-{{z.state}}' data-zone='head'
                cx='60' cy='20' r='16'/>
      {{/ifEquals}}
      {{#ifEquals z.zone 'torso'}}
        <rect class='zone zone-{{z.state}}' data-zone='torso'
              x='41' y='40' width='38' height='54' rx='5'/>
      {{/ifEquals}}
      {{#ifEquals z.zone 'arms'}}
        <g class='zone zone-{{z.state}}' data-zone='arms'>
          <rect x='22' y='42' width='15' height='50' rx='6'/>
          <rect x='83' y='42' width='15' height='50' rx='6'/>
        </g>
      {{/ifEquals}}
      {{#ifEquals z.zone 'legs'}}
        <g class='zone zone-{{z.state}}' data-zone='legs'>
          <rect x='43' y='98' width='15' height='62' rx='5'/>
          <rect x='62' y='98' width='15' height='62' rx='5'/>
        </g>
      {{/ifEquals}}
    {{/each}}
  </svg>

  <div class='paperdoll-zones'>

    {{!-- The Unterkleidung is not a hit location: it applies in all four
    zones at once, so it leads the list rather than sitting among them. --}}
    <div class='armor-row armor-suit {{#if paperdoll.suit}}draggable{{else}}armor-empty{{/if}}'
         data-zone='suit'
         {{#if paperdoll.suit}}data-item-id='{{paperdoll.suit.id}}' draggable='true'{{/if}}
         title='{{localize "TNO.Armor.SuitHint"}} — {{#if paperdoll.suit}}{{localize "TNO.Armor.WornHint"}}{{else}}{{localize "TNO.Armor.DropHint"}}{{/if}}'>
      {{#if paperdoll.suit}}
        <span class='armor-name'>{{paperdoll.suit.name}}</span>
        <span class='armor-values'>
          <span class='armor-value' title='{{localize "TNO.Armor.Rw"}}'>
            <span class='armor-key'>{{localize 'TNO.Armor.RwShort'}}</span>{{paperdoll.suit.system.rw}}
          </span>
          <span class='armor-value' title='{{localize "TNO.Armor.Ra"}}'>
            <span class='armor-key'>{{localize 'TNO.Armor.RaShort'}}</span>{{paperdoll.suit.system.ra}}
          </span>
        </span>
        <a class='armor-unequip' data-zone='suit' title='{{localize "TNO.Armor.Unequip"}}'>
          <i class='fas fa-times'></i>
        </a>
      {{else}}
        <span class='armor-name'>{{localize 'TNO.Armor.Zone.Suit'}} · {{localize 'TNO.Armor.Empty'}}</span>
      {{/if}}
    </div>

    {{#each paperdoll.zones as |z|}}
      <div class='armor-row {{#if z.item}}draggable{{else}}armor-empty{{/if}}' data-zone='{{z.zone}}'
           {{#if z.item}}data-item-id='{{z.item.id}}' draggable='true'{{/if}}
           title='{{#if z.item}}{{localize "TNO.Armor.WornHint"}}{{else}}{{localize "TNO.Armor.DropHint"}}{{/if}}'>
        {{#if z.item}}
          <span class='armor-name'>{{localize z.label}} · {{z.item.name}}</span>
          {{!-- Effective values, already layered with the Unterkleidung in
          prepareDerivedData: RH from the addon alone, RW and RA summed. --}}
          <span class='armor-values'>
            <span class='armor-value' title='{{localize "TNO.Armor.Rh"}}'>
              <span class='armor-key'>{{localize 'TNO.Armor.RhShort'}}</span>{{z.rh}}
            </span>
            <span class='armor-value' title='{{localize "TNO.Armor.Rw"}}'>
              <span class='armor-key'>{{localize 'TNO.Armor.RwShort'}}</span>{{z.rw}}
            </span>
            <span class='armor-value' title='{{localize "TNO.Armor.Ra"}}'>
              <span class='armor-key'>{{localize 'TNO.Armor.RaShort'}}</span>{{z.ra}}
            </span>
          </span>
          <a class='armor-unequip' data-zone='{{z.zone}}' title='{{localize "TNO.Armor.Unequip"}}'>
            <i class='fas fa-times'></i>
          </a>
        {{else}}
          <span class='armor-name'>{{localize z.label}} · {{localize 'TNO.Armor.Empty'}}</span>
          {{!-- A bare suit still covers this zone, so show what it contributes
          rather than implying the location is unprotected. --}}
          {{#if ../paperdoll.suit}}
            <span class='armor-values armor-values-suit'>
              <span class='armor-value' title='{{localize "TNO.Armor.Rw"}}'>
                <span class='armor-key'>{{localize 'TNO.Armor.RwShort'}}</span>{{z.rw}}
              </span>
              <span class='armor-value' title='{{localize "TNO.Armor.Ra"}}'>
                <span class='armor-key'>{{localize 'TNO.Armor.RaShort'}}</span>{{z.ra}}
              </span>
            </span>
          {{/if}}
        {{/if}}
      </div>
    {{/each}}

    {{#if paperdoll.svPenalty}}
      <div class='armor-warning' title='{{localize "TNO.Armor.SvPenaltyHint"}}'>
        <i class='fas fa-triangle-exclamation'></i>
        {{localize 'TNO.Armor.SvPenalty' str=system.abilities.str.base sv=paperdoll.sv}}
      </div>
    {{/if}}

  </div>

  {{!-- Geld, Papiere, Krimskrams: nominally 0 slots, so they never occupy a
  cell in the carry raster and get a column of their own here instead. Listed
  downwards rather than run across a band — the names are short and the height
  is free, whereas width in this aside is not. Same interactions as a slot
  cell: costing nothing to carry does not make it a different kind of thing,
  it can still be opened, sorted and worn. --}}
  {{#if slotGrid.trinkets.length}}
    <div class='slot-trinkets'>
      {{!-- The explanation hangs off the label rather than the whole block: the
      items below carry their own tooltips, and a container-wide one only ever
      showed in the gaps between them. --}}
      <span class='slot-trinkets-label'
            data-tooltip-html='{{localize "TNO.Inventory.TrinketsHint"}}'
            data-tooltip-direction='LEFT'>{{localize 'TNO.Inventory.Trinkets'}}</span>
      {{#each slotGrid.trinkets as |trinket|}}
        <span class='slot-trinket draggable' data-item-id='{{trinket.item._id}}'
              data-tooltip-html='{{trinket.tip}}' data-tooltip-direction='UP'>
          <img src='{{trinket.item.img}}' width='14' height='14' alt=''/>
          <span class='slot-trinket-name'>{{trinket.item.name}}</span>
          {{#if trinket.showQty}}<span class='slot-qty'>×{{trinket.quantity}}</span>{{/if}}
        </span>
      {{/each}}
    </div>
  {{/if}}
</div>
