{{!-- Paper doll: the Unterkleidung as a base layer beneath four zone rows,
mirroring the Rüstungen table's hit locations (Kopf, Torso, Arme, Beine).

An empty row is a drop target and nothing else: a piece is worn by dragging it
from the carry grid onto its zone (see `_onDrop`). Clicking one used to offer to
author a piece on the spot, which conjured gear out of an empty doll — wearing
something is a state change on gear already in hand.

The figure sizes to itself and the zone rows take the rest. The zero-slot pocket
used to hang off the last quarter of this block and now has a column of its own
in the row (see `actor-trinkets.hbs`) — the loose items are carried, not
worn, and reading them off the armour card said otherwise. --}}
<div class='paperdoll'>

  {{!-- The viewBox is cropped to the drawing's actual bounds (x 22-98,
  y 4-160, plus a stroke's worth of margin) rather than a round 120x178 canvas,
  so the figure fills its box instead of floating in dead space. --}}
  <svg class='paperdoll-figure' viewBox='19 1 82 162' role='img'
       aria-label='{{localize "TNO.Armor.FigureAlt"}}'>
    <title>{{localize 'TNO.Armor.Zones'}}</title>
    {{!-- Every location keeps a full-size base shape for the Unterkleidung
    state (`bare` or `suited`). A worn addon is drawn as a smaller plate above
    it, leaving the base visible around the edge. That way the figure can show
    both layers at once instead of replacing the suit state with `filled`. --}}
    {{#each paperdoll.zones as |z|}}
      {{#ifEquals z.zone 'head'}}
        <g class='zone zone-{{z.baseState}}' data-zone='head'>
          <circle class='zone-base' cx='60' cy='20' r='16'/>
          {{#if z.item}}
            <circle class='zone-plate' cx='60' cy='20' r='12.5'/>
          {{/if}}
        </g>
      {{/ifEquals}}
      {{#ifEquals z.zone 'torso'}}
        <g class='zone zone-{{z.baseState}}' data-zone='torso'>
          <rect class='zone-base' x='41' y='40' width='38' height='54' rx='5'/>
          {{#if z.item}}
            <rect class='zone-plate' x='45' y='44' width='30' height='46' rx='4'/>
          {{/if}}
        </g>
      {{/ifEquals}}
      {{#ifEquals z.zone 'arms'}}
        <g class='zone zone-{{z.baseState}}' data-zone='arms'>
          <rect class='zone-base' x='22' y='42' width='15' height='50' rx='6'/>
          <rect class='zone-base' x='83' y='42' width='15' height='50' rx='6'/>
          {{#if z.item}}
            <rect class='zone-plate' x='24' y='46' width='11' height='42' rx='4'/>
            <rect class='zone-plate' x='85' y='46' width='11' height='42' rx='4'/>
          {{/if}}
        </g>
      {{/ifEquals}}
      {{#ifEquals z.zone 'legs'}}
        <g class='zone zone-{{z.baseState}}' data-zone='legs'>
          <rect class='zone-base' x='43' y='98' width='15' height='62' rx='5'/>
          <rect class='zone-base' x='62' y='98' width='15' height='62' rx='5'/>
          {{#if z.item}}
            <rect class='zone-plate' x='45' y='102' width='11' height='54' rx='4'/>
            <rect class='zone-plate' x='64' y='102' width='11' height='54' rx='4'/>
          {{/if}}
        </g>
      {{/ifEquals}}
    {{/each}}
  </svg>

  <div class='paperdoll-zones'>

    {{#each paperdoll.zones as |z|}}
      <div class='armor-row {{#if z.item}}draggable{{else}}armor-empty{{/if}}' data-zone='{{z.zone}}'
           {{#if z.item}}data-item-id='{{z.item.id}}' draggable='true'{{/if}}
           title='{{#if z.item}}{{localize "TNO.Armor.WornHint"}}{{else}}{{localize "TNO.Armor.DropHint"}}{{/if}}'>
        {{#if z.item}}
          <span class='armor-name'>{{localize z.label}} · {{z.item.name}}</span>
          {{!-- Effective values, already layered with the Unterkleidung in
          prepareDerivedData: RH and RA from the addon alone, RW summed.
          Each value names the slot it owns, so the read-outs line up as
          columns even on the rows that carry RW alone. --}}
          <span class='armor-values'>
            <span class='armor-value armor-value-rh' title='{{localize "TNO.Armor.Rh"}}'>
              <span class='armor-key'>{{localize 'TNO.Armor.RhShort'}}</span>{{z.rh}}
            </span>
            <span class='armor-value armor-value-rw' title='{{localize "TNO.Armor.Rw"}}'>
              <span class='armor-key'>{{localize 'TNO.Armor.RwShort'}}</span>{{z.rw}}
            </span>
            <span class='armor-value armor-value-ra' title='{{localize "TNO.Armor.Ra"}}'>
              <span class='armor-key'>{{localize 'TNO.Armor.RaShort'}}</span>{{z.ra}}
            </span>
          </span>
          <a class='armor-unequip' data-zone='{{z.zone}}' title='{{localize "TNO.Armor.Unequip"}}'>
            <i class='fas fa-times'></i>
          </a>
        {{else}}
          <span class='armor-name'>{{localize z.label}} · {{localize 'TNO.Armor.Empty'}}</span>
          {{!-- A bare suit still pads this zone, so show the RW it contributes
          rather than implying the location is unprotected. Hardness and
          coverage are the addon's alone and are both 0 here, which is a fact
          about the missing addon, not a value of the suit. --}}
          {{#if ../paperdoll.suit}}
            <span class='armor-values armor-values-suit'>
              <span class='armor-value armor-value-rw' title='{{localize "TNO.Armor.Rw"}}'>
                <span class='armor-key'>{{localize 'TNO.Armor.RwShort'}}</span>{{z.rw}}
              </span>
            </span>
          {{/if}}
        {{/if}}
      </div>
    {{/each}}

    {{!-- The Unterkleidung is not a hit location: it applies in all four zones
    at once. It closes the list rather than sitting among them — the base layer
    is worn *beneath* everything above it, so the bottom is where it reads as
    the foundation rather than as a fifth location. --}}
    <div class='armor-row armor-suit {{#if paperdoll.suit}}draggable{{else}}armor-empty{{/if}}'
         data-zone='suit'
         {{#if paperdoll.suit}}data-item-id='{{paperdoll.suit.id}}' draggable='true'{{/if}}
         title='{{localize "TNO.Armor.SuitHint"}} — {{#if paperdoll.suit}}{{localize "TNO.Armor.WornHint"}}{{else}}{{localize "TNO.Armor.DropHint"}}{{/if}}'>
      {{#if paperdoll.suit}}
        {{!-- Named the same way as every other row. Dropping the location once
        a piece is worn left the base layer indistinguishable from a fifth hit
        location — exactly when knowing which row is which matters most. --}}
        <span class='armor-name'>{{localize 'TNO.Armor.Zone.Suit'}} · {{paperdoll.suit.name}}</span>
        {{!-- The padding is the only value a suit carries. Its RH is the fixed 0
        of the Rüstungstabelle and it has no RA at all, so neither is worth a
        box on the play surface. The RW keeps the addons' RW column all the
        same, so the layer that adds to every zone reads down the same line as
        what it adds to. --}}
        <span class='armor-values'>
          <span class='armor-value armor-value-rw' title='{{localize "TNO.Armor.Rw"}}'>
            <span class='armor-key'>{{localize 'TNO.Armor.RwShort'}}</span>{{paperdoll.suit.system.rw}}
          </span>
        </span>
        <a class='armor-unequip' data-zone='suit' title='{{localize "TNO.Armor.Unequip"}}'>
          <i class='fas fa-times'></i>
        </a>
      {{else}}
        <span class='armor-name'>{{localize 'TNO.Armor.Zone.Suit'}} · {{localize 'TNO.Armor.Empty'}}</span>
      {{/if}}
    </div>

    {{#if paperdoll.svPenalty}}
      <div class='armor-warning' title='{{localize "TNO.Armor.SvPenaltyHint"}}'>
        <i class='fas fa-triangle-exclamation'></i>
        {{localize 'TNO.Armor.SvPenalty' str=system.abilities.str.base sv=paperdoll.svLabel}}
      </div>
    {{/if}}

  </div>

</div>
