{{!-- Merkmale: what the character *is* rather than what they carry. Not
objects — they cost no slots and never enter the carry budget — so the Basics
tab's equipment views have no place for them and this is the only surface that
lists them.

A partial rather than markup inside `actor-items.hbs`, matching the other three
sections of that tab: each is its own file, and the tab is the composition. --}}
<div class='basics-section-header'>
  <h3 class='basics-section-title'>{{localize 'TNO.Features.Title'}}</h3>
  {{#if editable}}
    {{!-- `.section-add` is the look, `.item-create` is the action. The two are
    separate classes so this cannot also fire the gear-authoring dialog that
    `.inventory-add` opens on the section above. --}}
    <a class='section-add item-create' data-type='feature'
       title='{{localize "TNO.Features.Add"}}'>
      <i class='fas fa-plus'></i>
    </a>
  {{/if}}
</div>

{{#if features.length}}
  <ol class='items-list'>
    {{#each features as |item|}}
      <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name'>
          <div class='item-image'>
            <i class='fa-solid fa-star inventory-item-icon' aria-hidden='true'></i>
          </div>
          <h4 title='{{item.name}}'>{{item.name}}</h4>
        </div>
        <div class='item-controls'>
          <a class='item-control item-edit' title='{{localize "TNO.Item.Edit"}}'>
            <i class='fas fa-edit'></i>
          </a>
          {{!-- `@root.editable`, not `editable`: inside an `each` a bare name
          resolves against the item, which has no such key. --}}
          {{#if @root.editable}}
            <a class='item-control item-delete' title='{{localize "TNO.Item.Delete"}}'>
              <i class='fas fa-trash'></i>
            </a>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>
{{else}}
  <p class='items-empty'>{{localize 'TNO.Features.Empty'}}</p>
{{/if}}
