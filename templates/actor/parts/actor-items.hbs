{{!-- The flat administrative surface: creating, editing, deleting and stowing
items. The paper doll and the Trageslots grid used to sit above it and now live
in the character sheet's Basics tab, beside the attributes — they answer "what
am I wearing / hauling right now?", which is asked mid-roll, not while
bookkeeping. `paperdoll` still gates the armour create control below, since it
is the flag that says "this actor has an equipment store" (NPCs share this
partial and have none). --}}
<ol class='items-list'>
  <li class='item flexrow items-header'>
    {{!-- Column captions only make sense once there are rows to label; while
    the inventory is empty just the create control shows, above the
    empty-state hint below. --}}
    {{#if inventory.length}}
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class='item-formula'>{{localize 'Roll Formula'}}</div>
    {{/if}}
    <div class='item-controls'>
      {{!-- Armour needs its own control: it is a distinct item type with the
      zone/RH/RW/RA fields, and without a way to create one here the paper doll
      can never be filled — equipping only ever offers gear the actor already
      owns. --}}
      {{#if paperdoll}}
        <a
          class='item-control item-create'
          title='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.armor")}}'
          data-type='armor'
        >
          <i class='fas fa-shield-halved'></i>
          {{localize 'DOCUMENT.New' type=(localize 'TYPES.Item.armor')}}
        </a>
      {{/if}}
      <a
        class='item-control item-create'
        title='{{localize "DOCUMENT.Create" type='Item'}}'
        data-type='item'
      >
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='item'}}
      </a>
    </div>
  </li>
  {{#unless inventory.length}}
  <li class='items-empty'>{{localize 'TNO.ItemsEmptyHint'}}</li>
  {{/unless}}
  {{#each inventory as |item id|}}
    {{!-- `draggable` is the selector ActorSheetV2's inherited DragDrop binds,
    which is what lets a row be dragged onto the hotbar as a macro. --}}
    <li class='item flexrow draggable {{#if item.isStowed}}item-stowed{{/if}}' data-item-id='{{item._id}}'>
      <div class='item-name'>
        <div class='item-image'>
          <a class='rollable' data-roll-type='item'>
            <img
              src='{{item.img}}'
              title='{{item.name}}'
              width='24'
              height='24'
            />
          </a>
        </div>
        <h4>{{item.name}}</h4>
      </div>
      <div class='item-formula item-prop'>{{item.system.formula}}</div>
      <div class='item-controls'>
        {{!-- Where the item is. Worn gear is the paper doll's business — it is
        exempt from the slot economy either way — so it shows a static marker
        rather than a toggle that would fight the doll for the same state. --}}
        {{#if item.isWorn}}
          <span class='item-state item-state-worn' title='{{localize "TNO.Inventory.WornHint"}}'>
            <i class='fas fa-user-shield'></i>
          </span>
        {{else}}
          <a
            class='item-control item-carry-toggle'
            title='{{localize "TNO.Inventory.ToggleCarried"}} — {{#if item.isStowed}}{{localize "TNO.Inventory.StowedHint"}}{{else}}{{localize "TNO.Inventory.Slots"}}{{/if}}'
          >
            <i class='fas {{#if item.isStowed}}fa-box-archive{{else}}fa-person-walking-luggage{{/if}}'></i>
          </a>
        {{/if}}
        <a
          class='item-control item-edit'
          title='{{localize "DOCUMENT.Update" type='Item'}}'
        >
          <i class='fas fa-edit'></i>
        </a>
        <a
          class='item-control item-delete'
          title='{{localize "DOCUMENT.Delete" type='Item'}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>