{{!-- Die drei Bewegungsstufen, im Banner neben den Schadensleisten: über
jedem Tab lesbar, weil sie im Kampf jede Runde gebraucht werden.

Reine Anzeige — Text ohne Rahmen, an dem nichts zu klicken ist.

Eine Stufe, die die Last gekostet hat, wird an der Zahl durchgestrichen, die sie
wegnimmt. Die Last selbst steht als Zustände-Eintrag eine Zeile darunter. --}}
<div class='derived-movement'
     data-tooltip-html='<dl class="tno-tooltip">
<div class="tno-tooltip-row"><dt>{{localize "TNO.Derived.MovementCrawl"}} <span class="tno-tooltip-value">{{system.derived.movementCrawl}}</span></dt><dd>{{localize "TNO.DerivedHint.MovementCrawl"}}</dd></div>
<div class="tno-tooltip-row"><dt>{{localize "TNO.Derived.MovementWalk"}} <span class="tno-tooltip-value">{{system.derived.movementWalk}}</span></dt><dd>{{#if movement.walkBlocked}}{{localize "TNO.DerivedHint.CrawlOnly"}}{{else}}{{localize "TNO.DerivedHint.MovementWalk"}}{{/if}}</dd></div>
<div class="tno-tooltip-row"><dt>{{localize "TNO.Derived.MovementSprint"}} <span class="tno-tooltip-value">{{system.derived.movementSprint}}</span></dt><dd>{{#if movement.sprintBlocked}}{{localize "TNO.DerivedHint.NoSprint"}}{{else}}{{localize "TNO.DerivedHint.MovementSprint"}}{{/if}}</dd></div>
</dl>'
     data-tooltip-direction='DOWN'>
  <span class='derived-cell-label'>{{localize 'TNO.DerivedShort.Movement'}}</span>
  <span class='derived-move-tiers'>
    <span class='derived-move'>
      <b>{{system.derived.movementCrawl}}</b>
      <span>{{localize 'TNO.DerivedShort.MovementCrawl'}}</span>
    </span>
    <span class='derived-move{{#if movement.walkBlocked}} move-blocked{{/if}}'>
      <b>{{system.derived.movementWalk}}</b>
      <span>{{localize 'TNO.DerivedShort.MovementWalk'}}</span>
    </span>
    <span class='derived-move{{#if movement.sprintBlocked}} move-blocked{{/if}}'>
      <b>{{system.derived.movementSprint}}</b>
      <span>{{localize 'TNO.DerivedShort.MovementSprint'}}</span>
    </span>
  </span>
</div>
