{{!-- Trageslots: carried gear packed into the slot budget. The layout is
derived on every render from the items' existing sort order — nothing about
the arrangement is stored — so reordering is purely a view concern.

Worn clothing and armour never appear here: "Von den Inventarregeln
ausgenommen sind Kleidung und Rüstung welche der Charakter am Leib trägt".
Neither does stowed gear (`system.carried` false) — the character owns it,
but it is not on them.

The grid holds exactly as many cells as the character has slots; there is no
padding out to the raster width. Anything past the budget keeps running on in
the same grid, marked over capacity. --}}
<div class='slot-grid-block card'>

  <div class='slot-grid-header'>
    <span class='slot-grid-title'>{{localize 'TNO.Inventory.CarrySlots'}}</span>
    <span class='slot-grid-count'>
      <strong class='{{#if slotGrid.over}}over-capacity{{/if}}'>{{slotGrid.used}}</strong>/{{slotGrid.capacity}}
    </span>

    {{!-- What the load costs in movement is shown on the movement chip in the
    banner, struck through the tier it takes away — the question it answers is
    "how far can I move", so it belongs on the numbers, not over the bag.
    "Keine Tasche" stays here: it is not a load level but the reason this whole
    budget reads 0, and nowhere else says so. --}}
    {{#ifEquals slotGrid.state 'noContainer'}}
      <span class='slot-badge badge-no-container' title='{{localize "TNO.Inventory.NoContainerHint"}}'>
        {{localize 'TNO.Inventory.NoContainer'}}
      </span>
    {{/ifEquals}}

    {{#if @root.editable}}
      <a class='inventory-add' title='{{localize "TNO.Inventory.AddHint"}}'>
        <i class='fas fa-plus'></i>
      </a>
    {{/if}}
  </div>

  {{!-- `draggable` is the class core's DragDrop binds, which is what puts the
  item on the drag payload: without it a cell drags as an empty ghost. Dragging
  a cell onto another sorts the list (core's _onSortItem), onto a free cell
  moves it to the end, and armour dragged onto its paper doll zone is worn. --}}
  <div class='slot-grid'>
    {{#each slotGrid.blocks as |block|}}
      <div class='slot-cell slot-filled draggable {{#if block.over}}over-capacity{{/if}}'
           style='--slot-span: {{block.span}}'
           data-item-id='{{block.item._id}}'
           title='{{block.item.name}} · {{block.span}} — {{localize "TNO.Inventory.CellHint"}}'>
        <i class='fas fa-grip-vertical slot-grip'></i>
        <img class='slot-icon' src='{{block.item.img}}' width='20' height='20' alt=''/>
        <span class='slot-name'>{{block.item.name}}</span>
        {{#if block.showQty}}<span class='slot-qty'>×{{block.quantity}}</span>{{/if}}
      </div>
    {{/each}}

    {{#each slotGrid.emptyCells}}
      <div class='slot-cell slot-empty' title='{{localize "TNO.Inventory.EmptyCellHint"}}'></div>
    {{/each}}

    {{!-- Past the budget. The grid simply keeps running: cells up to capacity
    are the slots the character has, and these are the load that no longer fits
    in them, marked as over capacity rather than drawn as if they were slots.
    A block lands here as soon as it does not fit whole — half an item cannot
    sit in a slot the character does not have. --}}
    {{#each slotGrid.overflow as |block|}}
      <div class='slot-cell slot-filled draggable over-capacity'
           style='--slot-span: {{block.span}}'
           data-item-id='{{block.item._id}}'
           title='{{block.item.name}} · {{block.span}} · {{localize "TNO.Inventory.OverflowHint"}}'>
        <i class='fas fa-triangle-exclamation slot-overflow-icon'></i>
        <img class='slot-icon' src='{{block.item.img}}' width='20' height='20' alt=''/>
        <span class='slot-name'>{{block.item.name}}</span>
        {{#if block.showQty}}<span class='slot-qty'>×{{block.quantity}}</span>{{/if}}
      </div>
    {{/each}}
  </div>

  {{#if slotGrid.overflow.length}}
    <p class='slot-grid-note slot-grid-overflow-note'>
      {{localize 'TNO.Inventory.Overflow' excess=slotGrid.excess}}
    </p>
  {{/if}}

  {{!-- Geld, Papiere, Krimskrams: nominally 0 slots, so they get a band rather
  than cells they would otherwise occupy at zero width. It is deliberately half
  a cell tall and labelled — the height says "less than a slot" before the label
  is read, and the enclosure keeps it part of the same bag instead of trailing
  off below the card as loose text. --}}
  {{#if slotGrid.trinkets.length}}
    <div class='slot-trinkets' title='{{localize "TNO.Inventory.TrinketsHint"}}'>
      <span class='slot-trinkets-label'>{{localize 'TNO.Inventory.Trinkets'}}</span>
      {{!-- Same interactions as a cell: these are items too, they just cost
      nothing to carry. --}}
      {{#each slotGrid.trinkets as |trinket|}}
        <span class='slot-trinket draggable' data-item-id='{{trinket.item._id}}'
              title='{{trinket.item.name}} — {{localize "TNO.Inventory.CellHint"}}'>
          <img src='{{trinket.item.img}}' width='14' height='14' alt=''/>
          <span class='slot-trinket-name'>{{trinket.item.name}}</span>
          {{#if trinket.showQty}}<span class='slot-qty'>×{{trinket.quantity}}</span>{{/if}}
        </span>
      {{/each}}
    </div>
  {{/if}}

</div>
