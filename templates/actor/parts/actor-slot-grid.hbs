{{!-- Trageslots: worn gear first, then carried gear, packed into one budget. The layout is
derived on every render from the items' existing sort order — nothing about
the arrangement is stored — so reordering is purely a view concern.
The grid holds exactly as many cells as the character has slots; there is no
padding out to the raster width. Anything past the budget keeps running on in
the same grid, marked over capacity. --}}
{{!-- The panel's title, used/capacity count and create action live on the
Inventar tab above it. "Keine Tasche" stays here: it is not a load level but the
reason only the worn band participates, and nowhere else says so. What the load
costs in movement is struck through on the movement line, not said here. --}}
{{#if slotGrid.noContainer}}
  <span class='slot-badge badge-no-container' title='{{localize "TNO.Inventory.NoContainerHint"}}'>
    {{localize 'TNO.Inventory.NoContainer'}}
  </span>
{{/if}}

{{!-- The budget as a meter, one segment per slot: the worn band, then carried
load, then free room, and past the budget the overload in warning red. It is
what the raster below no longer does by itself now that the free slots are one
summary cell: count the room that is left. --}}
<span class='slot-meter' role='img'
      aria-label='{{localize "TNO.Inventory.MeterLabel" used=slotGrid.used capacity=slotGrid.capacity}}'>
  {{#each slotGrid.meter as |segment|}}<span class='slot-meter-segment is-{{segment.tone}}'></span>{{/each}}
</span>

<div class='slot-grid-block'>

  {{!-- One cell per slot the load costs, in one flat run: what fits, then what
  spills past the budget, then — only when nothing spilled — the free cells.
  A multi-slot item is several adjacent cells joined by CSS rather than one
  element spanning columns, so it can wrap mid-item instead of jumping to the
  next row and holding the columns behind it open.

  `draggable` is the class core's DragDrop binds, which is what puts the item
  on the drag payload: without it a cell drags as an empty ghost. Every cell of
  a block carries the id so it can be grabbed and dropped onto along its whole
  length; `_onSortItem` is overridden to fold the repeats back into one
  sibling. Dragging a cell onto another sorts the list, onto a free cell moves
  it to the end, and armour dragged onto its paper doll zone is worn. --}}
  <div class='slot-grid'>
    {{#each slotGrid.cells as |cell|}}
      <div class='slot-cell slot-filled draggable{{#if cell.worn}} worn{{/if}}{{#if cell.held}} held{{/if}}{{#if cell.over}} over-capacity{{/if}}{{#if cell.first}} slot-first{{/if}}{{#if cell.showQty}} slot-with-qty{{/if}}{{#unless cell.last}} slot-joined{{/unless}}'
           style='--slot-run: {{cell.span}}'
           data-item-id='{{cell.item._id}}'
           {{#if cell.worn}}title='{{localize "TNO.Inventory.WornSlotHint"}}'{{else if cell.held}}title='{{localize "TNO.Inventory.HeldSlotHint"}}'{{/if}}>
        {{#if cell.first}}
          <i class='fas fa-grip-vertical slot-grip'></i>
          {{#if cell.over}}<i class='fas fa-triangle-exclamation slot-overflow-icon'></i>{{/if}}
          {{!-- The piece's own art when it has any, with its role as a badge
          on the corner; the role icon alone when it has none. Both occupy the
          same 40px box, so a grid of mixed items stays on its column rhythm. --}}
          <span class='slot-art-box'>
            {{#if cell.img}}
              <img class='slot-icon slot-art' src='{{cell.img}}' alt='' />
              <i class='fa-solid {{cell.icon}} slot-role-badge' aria-hidden='true'></i>
            {{else}}
              <i class='fa-solid {{cell.icon}} slot-icon' aria-hidden='true'></i>
            {{/if}}
          </span>
          <span class='slot-content'>
            {{!-- The name is clipped to the run's width, so the full one has to
            stay reachable on hover as well as through the popover a click
            opens — the skill list carries its own title for the same reason. --}}
            <span class='slot-name' title='{{cell.item.name}}'>{{cell.item.name}}</span>
            <span class='slot-subcategory'>{{#if cell.worn}}{{localize 'TNO.Inventory.WornSlot'}}{{#if cell.typeLine}} · {{/if}}{{else if cell.held}}{{localize 'TNO.Inventory.Held'}}{{#if cell.typeLine}} · {{/if}}{{/if}}{{cell.typeLine}}</span>
          </span>
          {{#if cell.showQty}}<span class='slot-qty'>×{{cell.quantity}}</span>{{/if}}
        {{/if}}
      </div>
    {{/each}}

    {{!-- The free room as one cell: still a drop target that moves a piece to
    the end of the run, and for an owner the same create action as the header's
    `+`. --}}
    {{#if slotGrid.free}}
      <div class='slot-cell slot-empty{{#if @root.editable}} inventory-add{{/if}}'
           data-tooltip-html='{{localize "TNO.Inventory.EmptyCellHint"}}'
           data-tooltip-direction='UP'>
        {{#if @root.editable}}<i class='fas fa-plus' aria-hidden='true'></i>{{/if}}
        {{localize 'TNO.Inventory.FreeSlots' count=slotGrid.free}}
      </div>
    {{/if}}
  </div>

  {{!-- Keyed off the budget, not off `overflow`: a block that merely straddles
  the boundary is packed rather than pushed out, so the load can run over
  capacity with nothing in `overflow` at all — which is precisely when this
  needs saying. --}}
  {{#if slotGrid.over}}
    <p class='slot-grid-note slot-grid-overflow-note'>
      {{localize 'TNO.Inventory.Overflow' excess=slotGrid.excess}}
    </p>
  {{/if}}


</div>

{{!-- Zurückgelassen: what the character still owns but does not have on them —
put down, handed over, taken away. Nothing here costs a slot, can be worn or
offers a combat action. Dragging gear onto the block leaves it here, dragging
it back into the raster (or onto the doll) picks it up again; the item's popover
does the same with one click. --}}
<div class='stash-block' data-tooltip-html='{{localize "TNO.Inventory.StashedHint"}}' data-tooltip-direction='UP'>
  <div class='stash-header'>
    <i class='fa-solid fa-box-archive' aria-hidden='true'></i>
    <span class='stash-title'>{{localize 'TNO.Inventory.Stashed'}}</span>
    {{#if slotGrid.stashed.length}}<span class='stash-count'>{{slotGrid.stashed.length}}</span>{{/if}}
  </div>
  {{#if slotGrid.stashed.length}}
    <div class='stash-list'>
      {{#each slotGrid.stashed as |entry|}}
        <span class='stash-item draggable' data-item-id='{{entry.item._id}}'>
          {{#if entry.img}}
            <img class='stash-item-icon slot-art' src='{{entry.img}}' alt='' />
          {{else}}
            <i class='fa-solid {{entry.icon}} stash-item-icon' aria-hidden='true'></i>
          {{/if}}
          <span class='stash-item-name' title='{{entry.item.name}}'>{{entry.item.name}}</span>
          {{#if entry.typeLine}}<span class='stash-item-type'>{{entry.typeLine}}</span>{{/if}}
          {{#if (gt entry.quantity 1)}}<span class='stash-item-qty'>×{{entry.quantity}}</span>{{/if}}
        </span>
      {{/each}}
    </div>
  {{else}}
    <p class='stash-empty'>{{localize 'TNO.Inventory.StashedEmpty'}}</p>
  {{/if}}
</div>
