<div class="tno-roll-card dice-roll" data-action="expandRoll">
  <div class="tno-roll-summary">
    <div class="tno-roll-title">
      {{#if flavor}}
      <h3 class="tno-roll-flavor">{{flavor}}</h3>
      {{/if}}
      <span class="tno-roll-advantage-badge" title="{{advantageLabel}}">{{advantageAbbr}}</span>
    </div>

    <div class="tno-roll-dice">
      {{#each dice as |die|}}
      <span class="tno-die{{#if die.isCounted}} counted{{/if}}">{{die.value}}</span>
      {{/each}}
      {{#if hasThreshold}}
      {{!-- The threshold chip carries the odds it was rolled against. No
            separate marker: a chip is already a bounded, hoverable object, and
            the odds belong to this number rather than sitting beside it. --}}
      <span class="tno-roll-threshold" data-tooltip-html="{{oddsTooltip}}">&le; {{threshold}}</span>
      {{/if}}
    </div>

    {{#if outcome}}
    <div class="tno-roll-outcome {{outcome}}">{{outcomeLabel}}</div>
    {{/if}}

    {{!-- Was der Verteidiger wissen muss, als Text. Kein Target, kein zweites
    Dokument, keine Rechte-Prüfung: der Angreifer sagt an, der Verteidiger trägt
    ein, was ihn betrifft — dieselbe Teilung, auf der der angesagte Schadenswert
    schon immer beruht. --}}
    {{#if envelope}}
    <div class="tno-roll-envelope">
      <span class="tno-envelope-from">{{localize "TNO.Combat.Envelope.From"}} {{envelope.from}}</span>
      <ul class="tno-envelope-lines">
        {{#each envelope.lines as |line|}}
        <li>{{line}}</li>
        {{/each}}
      </ul>
      {{!-- Eine Abkürzung, keine Pflicht. Der Knopf schreibt die Ansage auf den
      *eigenen* Bogen des Klickenden; welche Verteidigung dann geöffnet wird,
      bleibt ihm überlassen. Wer die Zahl lieber selbst eintippt, ignoriert ihn
      einfach — der Weg über das Feld im Dialog bleibt unverändert. --}}
      <button type="button" class="tno-envelope-take" data-tno-action="take-ansage">
        {{localize "TNO.Combat.Envelope.Take"}}
      </button>
    </div>
    {{/if}}
  </div>

  <div class="dice-tooltip tno-roll-tooltip">
    <div class="wrapper">
      {{#each components as |component|}}
      <div class="tno-roll-detail">
        <span class="tno-roll-detail-label">{{component.label}}</span>
        <span class="tno-roll-detail-value">{{#if component.display}}{{component.display}}{{else}}{{component.value}}{{/if}}</span>
      </div>
      {{/each}}
      {{#if showBonus}}
      <div class="tno-roll-detail">
        <span class="tno-roll-detail-label">{{localize "TNO.Roll.Bonus"}}</span>
        <span class="tno-roll-detail-value">{{bonusDisplay}}</span>
      </div>
      {{/if}}
      {{#if hasThreshold}}
      <div class="tno-roll-detail">
        <span class="tno-roll-detail-label">{{localize "TNO.Roll.Threshold"}}</span>
        <span class="tno-roll-detail-value">{{threshold}}</span>
      </div>
      {{/if}}
      <div class="tno-roll-detail">
        <span class="tno-roll-detail-label">{{localize "TNO.Roll.Advantage"}}</span>
        <span class="tno-roll-detail-value">{{advantageLabel}}</span>
      </div>
    </div>
  </div>
</div>
