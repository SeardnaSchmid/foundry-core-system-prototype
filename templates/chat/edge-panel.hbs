{{#if showViews}}
<div class="tno-edge-views">
  <div class="tno-edge-view-main">
    {{#if xpOptions.length}}
    <div class="tno-xp-claim-row">
      <span class="tno-xp-claim-caption">{{xpCaption}}</span>
      <div class="tno-xp-claim-buttons">
        {{#each xpOptions}}
        <button type="button" class="tno-xp-claim-button" data-edge-action="{{this.action}}">
          <i class="fa-solid fa-star"></i> {{this.label}}
        </button>
        {{/each}}
      </div>
    </div>
    {{/if}}
    {{#unless committed}}
    {{#if hasEdgeActions}}
    <a class="tno-edge-toggle">
      <i class="fa-solid fa-screwdriver-wrench"></i> {{triggerLabel}}
      <i class="fa-solid fa-chevron-right tno-edge-chevron"></i>
    </a>
    {{/if}}
    {{/unless}}
  </div>

  <div class="tno-edge-view-troubleshoot">
    {{> "systems/tno/templates/chat/parts/trial-error-tracker.hbs" tracker=tracker showReroll=true}}

    {{#each groups}}
    <div class="tno-edge-group{{#if this.chooser}} tno-edge-chooser{{/if}}">
      {{#if this.label}}<span class="{{#if this.section}}tno-edge-section-label{{else}}tno-edge-group-label{{/if}}">{{this.label}}</span>{{/if}}
      {{#each this.options}}
      {{#if this.big}}
      <div class="tno-edge-big{{#if this.disabled}} disabled{{/if}}" data-edge-action="{{this.action}}">
        <span class="tno-edge-big-title"><i class="fa-solid {{this.icon}}"></i> {{this.title}}</span>
        <span class="tno-edge-big-hint">{{this.hint}}</span>
      </div>
      {{else}}
      <div class="tno-edge-option{{#if this.disabled}} disabled{{/if}}" data-edge-action="{{this.action}}">
        <span class="tno-edge-option-icon"><i class="fa-solid {{this.icon}}"></i></span>
        <div class="tno-edge-option-text">
          <span class="tno-edge-option-title">{{this.title}}</span>
          <span class="tno-edge-option-hint">{{this.hint}}</span>
        </div>
        <i class="fa-solid fa-chevron-right tno-edge-option-run"></i>
      </div>
      {{/if}}
      {{/each}}
    </div>
    {{/each}}

    {{#if armedRetry}}
    <div class="tno-edge-retry-armed">
      <div class="tno-edge-retry-head">
        <span class="tno-edge-option-icon"><i class="fa-solid fa-arrow-rotate-right"></i></span>
        <div class="tno-edge-option-text">
          <span class="tno-edge-option-title">{{armedRetry.title}}</span>
          <span class="tno-edge-option-hint">{{armedRetry.hint}}</span>
        </div>
      </div>
      <div class="tno-edge-retry-controls">
        {{#if armedRetry.hasIdea}}
        <label class="tno-find-flaw-idea{{#if armedRetry.ideaDisabled}} disabled{{/if}}" title="{{#if armedRetry.ideaDisabled}}{{localize 'TNO.Notify.NoReserve'}}{{else}}{{localize 'TNO.DerivedHint.Insight'}}{{/if}}">
          <input type="checkbox" class="tno-edge-retry-idea" {{#if armedRetry.ideaDisabled}}disabled{{/if}}/>
          {{armedRetry.ideaLabel}}
        </label>
        {{/if}}
        <div class="tno-edge-retry-buttons">
          <a class="tno-edge-retry-cancel">{{armedRetry.cancelLabel}}</a>
          <a class="tno-edge-retry-run"><i class="fa-solid fa-dice-d20"></i> {{armedRetry.runLabel}}</a>
        </div>
      </div>
    </div>
    {{/if}}

    {{#unless committed}}
    <a class="tno-edge-back"><i class="fa-solid fa-chevron-left"></i> {{backLabel}}</a>
    {{/unless}}
  </div>
</div>
{{/if}}
