{{!-- The item editor, after the 2026-10 "Item-Editor" mockup. One column, read
top to bottom in the order a piece is authored:

  identity (picture, name, role) → the role's values → Inventar →
  Handel and Beschreibung (folded) → the required-field status in the foot.

Every value row is a `label | control` pair of the same width, so labels line
up down the whole sheet. A row the current role, use or location has nothing to
ask is left out rather than hatched: a ranged weapon has Reichweite where a
melee one has DK, and the Unterkleidung has neither RH nor RA. Handel and
Beschreibung fold away because they are filled once and then only read; their
summary line says what is in them while they are shut.

See `module/sheets/item-gear-sheet.mjs` for why there is no save button. --}}
<div class='gear-rows'>

  <header class='gear-identity'>
    {{!-- `data-edit` is the persistence half and `data-action` the gesture:
          `FormDataExtended` reads this element's `src` back as the `img` field
          because of the former, and `DocumentSheetV2`'s built-in `editImage`
          action opens the picker because of the latter. An `img` takes no
          focus of its own, hence the explicit `tabindex`/`role`. --}}
    <img class='profile-img gear-art' src='{{item.img}}' alt=''
      {{#if canEdit}}
        data-edit='img' data-action='editImage' tabindex='0' role='button'
        aria-label='{{localize "TNO.Item.ImageEdit"}}' title='{{localize "TNO.Item.ImageEdit"}}'
      {{else}}
        title='{{item.name}}'
      {{/if}} />

    <div class='gear-identity-fields'>
      {{#if canEdit}}
        <input class='gear-name {{#if missing.name}}is-missing{{/if}}' data-field='name' name='name' type='text'
               value='{{item.name}}' placeholder='{{localize "Name"}}' aria-label='{{localize "Name"}}' />
      {{else}}
        <h1 class='gear-title'>{{item.name}}</h1>
      {{/if}}

      {{!-- What the piece is. Exclusive, with "Gegenstand" — no role at all —
      as a real fourth answer rather than the state left behind by clicking a
      chip off: a radiogroup, because that is what the choice is, and unlike a
      Foundry item type it can be corrected after the fact. --}}
      <div class='gear-roles segments' role='radiogroup' aria-label='{{localize "TNO.Item.Editor.Role"}}'>
        {{#each roleChips}}
          <button type='button' class='role-chip' role='radio' data-role='{{this.key}}'
                  aria-checked='{{this.on}}' tabindex='0'>{{localize this.label}}</button>
        {{/each}}
      </div>
    </div>
  </header>

  {{#if roles.weapon}}
    <section class='gear-section' data-section='weapon'>
      {{> 'systems/tno/templates/item/parts/item-section-head.hbs' title='TNO.Weapons.Values' status=sections.weapon}}
      {{> 'systems/tno/templates/item/parts/item-role-weapon.hbs'}}
    </section>
  {{/if}}

  {{#if roles.armor}}
    <section class='gear-section' data-section='armor'>
      {{> 'systems/tno/templates/item/parts/item-section-head.hbs' title='TNO.Armor.Values' status=sections.armor}}
      {{> 'systems/tno/templates/item/parts/item-role-armor.hbs'}}
    </section>
  {{/if}}

  {{#if roles.consumable}}
    <section class='gear-section' data-section='consumable'>
      {{> 'systems/tno/templates/item/parts/item-section-head.hbs' title='TNO.Item.Effect' status=sections.consumable}}
      {{> 'systems/tno/templates/item/parts/item-role-consumable.hbs'}}
    </section>
  {{/if}}

  {{!-- What carrying it costs. SV is a requirement of weapons and armour
  only, and *Zweihändig* is asked of weapons — what a hand holds is
  bookkeeping, and the flag stays on any piece that already has it. --}}
  <section class='gear-section' data-section='inventory'>
    {{> 'systems/tno/templates/item/parts/item-section-head.hbs' title='TNO.Inventory.CarrySlots' status=sections.inventory}}
    <div class='gear-row {{#if missing.slots}}is-missing{{/if}}' data-row='slots'>
      <span class='gear-label' title='{{localize "TNO.Inventory.SlotsInfoLabel"}}'
            data-tooltip-html='{{localize "TNO.Inventory.SlotsInfo"}}' data-tooltip-direction='RIGHT'>{{localize 'TNO.Inventory.Slots'}}</span>
      <div class='gear-ctl gear-ctl-inline'>
        {{> 'systems/tno/templates/item/parts/item-scale.hbs' cells=scales.slots key='slots'}}
        {{#if roles.weapon}}
          <label class='gear-check' title='{{localize "TNO.Item.TwoHandedHint"}}'>
            <input type='checkbox' name='system.twoHanded' {{checked system.twoHanded}} />
            {{localize 'TNO.Item.TwoHanded'}}
          </label>
        {{/if}}
        {{#if roles.weapon}}
          <label class='gear-field gear-field-short' title='{{localize "TNO.Item.SvHintWeapon"}}'>
            <span class='cap'>{{localize 'TNO.Item.Cap.Sv'}}</span>
            <input type='number' name='system.sv' value='{{system.sv}}' min='0' step='1' />
          </label>
        {{else if roles.armor}}
          {{!-- Armour SV runs in quarter steps: every addon is written as a
          +0,25/+0,5/+1/+1,5 increment, and all of them add up. --}}
          <label class='gear-field gear-field-short' title='{{localize "TNO.Armor.SvHint"}}'>
            <span class='cap'>{{localize 'TNO.Item.Cap.Sv'}}</span>
            <input type='number' name='system.sv' value='{{system.sv}}' min='0' step='0.25' />
          </label>
        {{/if}}
      </div>
    </div>
  </section>

  <details class='gear-fold' data-fold='trade' {{#if folds.trade}}open{{/if}}>
    <summary>
      <span class='gear-fold-caret' aria-hidden='true'></span>
      <span class='gear-section-title'>{{localize 'TNO.Item.Trade'}}</span>
      <span class='gear-fold-summary'>{{tradeSummary}}</span>
    </summary>
    <div class='gear-fold-body'>
      {{!-- Quantity is the stack, and so a multiple of the slot cost. --}}
      <div class='gear-row' data-row='quantity'>
        <span class='gear-label' title='{{localize "TNO.Item.QuantityHint"}}'>{{localize 'TNO.Inventory.Quantity'}}</span>
        <div class='gear-ctl'>
          <span class='stepper' title='{{localize "TNO.Item.QuantityHint"}}'>
            <button type='button' class='stepper-button' data-field='system.quantity' data-by='-1'
                    aria-label='{{localize "TNO.Item.Editor.Less"}}'>&minus;</button>
            <input type='number' name='system.quantity' value='{{system.quantity}}' min='0' step='1' />
            <button type='button' class='stepper-button' data-field='system.quantity' data-by='1'
                    aria-label='{{localize "TNO.Item.Editor.More"}}'>+</button>
          </span>
        </div>
      </div>
      <div class='gear-row' data-row='price'>
        <span class='gear-label' title='{{localize "TNO.Item.PriceHint"}}'>{{localize 'TNO.Item.Editor.Price'}}</span>
        <div class='gear-ctl'>
          <label class='gear-field gear-field-price' title='{{localize "TNO.Item.PriceHint"}}'>
            <span class='cap'>€</span>
            <input type='number' name='system.price' value='{{system.price}}' min='0' step='1' placeholder='0' />
          </label>
        </div>
      </div>
      <div class='gear-row' data-row='availability'>
        <span class='gear-label' title='{{localize "TNO.Item.AvailabilityHint"}}'>{{localize 'TNO.Item.Availability'}}</span>
        {{> 'systems/tno/templates/item/parts/item-scale.hbs' cells=scales.availability key='availability'}}
      </div>
    </div>
  </details>

  <details class='gear-fold' data-fold='description' {{#if folds.description}}open{{/if}}>
    <summary>
      <span class='gear-fold-caret' aria-hidden='true'></span>
      <span class='gear-section-title'>{{localize 'TNO.TabDescription'}}</span>
      <span class='gear-fold-summary'>{{descriptionSummary}}</span>
    </summary>
    <div class='gear-fold-body'>
      {{!-- Always-on editor rather than ProseMirror's click-to-edit toggle:
      the dialog is a form, and a box you have to click a pencil on before
      typing is the one control here that would not behave like the rest. --}}
      <prose-mirror class='memo' id='gear-description-{{item.id}}' name='system.description'
                    value='{{system.description}}' aria-label='{{localize "TNO.TabDescription"}}'></prose-mirror>
    </div>
  </details>

</div>{{!-- .gear-rows --}}

{{!-- The whole item's status, then the two acts that take the whole thing
somewhere: to chat, or away. Each missing field is a button to it. --}}
<footer class='gear-foot'>
  <span class='gear-status {{#if missingCount}}is-missing{{/if}}' role='status' aria-live='polite'>
    <span class='gear-status-dot' aria-hidden='true'></span>
    {{#if missingCount}}
      <span>{{localize 'TNO.Item.Editor.Open'}}</span>
      {{#each missingFields}}
        <button type='button' class='gear-missing-link' data-missing-field='{{this.field}}'
                title='{{localize "TNO.Item.MissingRequiredHint"}}'>{{localize this.label}}</button>{{#unless @last}},{{/unless}}
      {{/each}}
    {{else}}
      {{localize 'TNO.Item.Editor.AllSet'}}
    {{/if}}
  </span>
  {{!-- Not gated on `canEdit`: an item opened out of the locked gear
  compendium is read-only, and showing the table what a piece is without
  unlocking the pack is exactly what this is for. --}}
  <button type='button' class='item-post-chat gear-foot-action' title='{{localize "TNO.Item.Overview.Post"}}'>
    {{localize 'TNO.Item.Editor.PostChat'}}
  </button>
  {{!-- Worn gear cannot be deleted: the actor's `system.equipment` would keep
  pointing at an id that no longer resolves. The control stays, disabled, with
  the reason as its tooltip. --}}
  {{#if canDelete}}
    <button type='button' class='item-self-delete gear-foot-delete' title='{{localize "TNO.Item.Delete"}}'
            aria-label='{{localize "TNO.Item.Delete"}}'><i class='fa-solid fa-trash' aria-hidden='true'></i></button>
  {{else if isWorn}}
    <span class='gear-foot-delete is-blocked' title='{{localize "TNO.Item.DeleteWornHint"}}'
          aria-label='{{localize "TNO.Item.DeleteWornHint"}}' role='img'><i class='fa-solid fa-trash' aria-hidden='true'></i></span>
  {{/if}}
</footer>
