{{!-- Waffen-Sheet. Bewusst nur die drei Spalten, die der Waffenblock auf dem
Charakterbogen ohnehin schon reserviert (Würfel, Schaden, Reichweite), und alle
drei als Freitext: die Waffenregeln sind noch nicht geschrieben, also ist hier
noch nichts zu rechnen. Was feststeht, ist nur, dass eine Waffe ein Gegenstand
ist — daher Menge und Slots wie bei jedem anderen Gepäckstück. --}}
<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
      <div class='grid grid-2col'>
        <div class='resource'>
          <label class='resource-label'>{{localize 'TNO.Inventory.Quantity'}}</label>
          <input
            type='text'
            name='system.quantity'
            value='{{system.quantity}}'
            data-dtype='Number'
          />
        </div>
        <div class='resource'>
          <label class='resource-label'>{{localize 'TNO.Inventory.Slots'}}</label>
          <input
            type='text'
            name='system.slots'
            value='{{system.slots}}'
            data-dtype='Number'
            title='{{localize "TNO.Inventory.SlotsHint"}}'
          />
        </div>
      </div>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>{{localize 'TNO.TabDescription'}}</a>
    <a class='item' data-tab='attributes'>{{localize 'TNO.Weapons.Values'}}</a>
    <a class='item' data-tab='effects'>{{localize 'TNO.TabEffects'}}</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>

    {{! Weapon Values Tab }}
    <div class='tab attributes' data-group='primary' data-tab='attributes'>
      <div class='grid grid-3col'>
        <div class='resource grid-span-1'>
          <label class='resource-label'>{{localize 'TNO.Weapons.Dice'}}</label>
          <input type='text' name='system.dice' value='{{system.dice}}'/>
        </div>
        <div class='resource grid-span-1'>
          <label class='resource-label'>{{localize 'TNO.Weapons.Damage'}}</label>
          <input type='text' name='system.damage' value='{{system.damage}}'/>
        </div>
        <div class='resource grid-span-1'>
          <label class='resource-label'>{{localize 'TNO.Weapons.Range'}}</label>
          <input type='text' name='system.range' value='{{system.range}}'/>
        </div>
      </div>

      <p class='hint'>{{localize 'TNO.Weapons.FieldsHint'}}</p>

      {{> "systems/tno/templates/item/parts/item-delete.hbs"}}
    </div>

    {{! Effects Tab }}
    <div class='tab effects' data-group='primary' data-tab='effects'>
      {{> "systems/tno/templates/item/parts/item-effects.hbs"}}
    </div>
  </section>
</form>
