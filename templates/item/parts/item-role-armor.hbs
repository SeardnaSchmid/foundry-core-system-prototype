{{!-- The armour's values. One piece belongs to exactly one location; clicking
the selected chip again clears it. The Unterkleidung is padding without a hit
location: every row of it in the Rüstungstabelle reads RH 0 and RA "–", so it
is asked for RW alone and a note says why the other two are gone. --}}

<div class='gear-row {{#if missing.zone}}is-missing{{/if}}' data-row='zone'>
  <span class='gear-label'>{{localize 'TNO.Armor.Zone.Label'}}</span>
  <div class='gear-ctl segments'>
    {{#each zoneChips}}
      <button type='button' class='zone-chip' data-zone='{{this.zone}}' aria-pressed='{{this.on}}'>
        {{localize this.label}}
      </button>
    {{/each}}
  </div>
</div>

{{#unless armorSuit}}
  <div class='gear-row {{#if missing.rh}}is-missing{{/if}}' data-row='rh'>
    <span class='gear-label' title='{{localize "TNO.Armor.RhHint"}}'>
      {{localize 'TNO.Armor.RhShort'}} <span class='gear-sublabel'>· {{localize 'TNO.Item.Editor.RhSub'}}</span>
    </span>
    {{> 'systems/tno/templates/item/parts/item-scale.hbs' cells=scales.rh key='rh'}}
  </div>
{{/unless}}

<div class='gear-row' data-row='rw'>
  <span class='gear-label' title='{{localize "TNO.Armor.RwHint"}}'>
    {{localize 'TNO.Armor.RwShort'}} <span class='gear-sublabel'>· {{localize 'TNO.Item.Editor.RwSub'}}</span>
  </span>
  {{> 'systems/tno/templates/item/parts/item-scale.hbs' cells=scales.rw key='rw'}}
</div>

{{#if armorSuit}}
  <p class='gear-note'>{{localize 'TNO.Item.Editor.SuitNote'}}</p>
{{else}}
  <div class='gear-row {{#if missing.ra}}is-missing{{/if}}' data-row='ra'>
    <span class='gear-label' title='{{localize "TNO.Armor.RaHint"}}'>
      {{localize 'TNO.Armor.RaShort'}} <span class='gear-sublabel'>· {{localize 'TNO.Item.Editor.RaSub'}}</span>
    </span>
    {{> 'systems/tno/templates/item/parts/item-scale.hbs' cells=scales.ra key='ra'}}
  </div>
{{/if}}
