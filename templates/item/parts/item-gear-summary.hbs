{{!-- The play-facing view of one piece of gear, shared by the actor sheet's
      popover and the chat card. Read top to bottom: what it is and where it
      is, its numbers, what is still missing, what a check with it starts from,
      then the stock or the description. Nothing about buying it appears here. --}}
<header class='item-popover-head'>
  <img src='{{item.img}}' width='56' height='56' alt=''/>
  <div class='item-popover-title'>
    <strong>{{item.name}}</strong>
    <span class='item-popover-subtitle'>{{summary.subtitle}}</span>
    {{#if presentation.ownership.label}}
      <span class='item-popover-state {{presentation.ownership.state}}'>{{localize presentation.ownership.label}}</span>
    {{/if}}
  </div>
  {{#if showClose}}
    <button type='button' class='item-popover-close' data-popover-action='close'
            title='{{localize "TNO.Item.Popover.Close"}}' aria-label='{{localize "TNO.Item.Popover.Close"}}'
            autofocus>
      <i class='fa-solid fa-xmark' aria-hidden='true'></i>
    </button>
  {{/if}}
</header>

<div class='item-popover-body'>
  {{#if summary.tiles.length}}
    <div class='item-popover-tiles'>
      {{#each summary.tiles}}
        <div class='item-popover-tile {{state}}{{#if wide}} wide{{/if}}' title='{{title}}'>
          <span class='val'>{{display}}</span>
          <span class='cap'>{{localize labelKey}}</span>
        </div>
      {{/each}}
    </div>
  {{/if}}

  {{#if roles.consumable}}
    <div class='item-popover-stock'>
      <span class='cap'>{{localize 'TNO.Item.Summary.Stock'}}</span>
      {{#if @root.canAdjustStock}}
        <span class='item-popover-stepper'>
          <button type='button' data-popover-action='stock' data-by='-1'
                  title='{{localize "TNO.Item.Overview.StockDecrease"}}'
                  aria-label='{{localize "TNO.Item.Overview.StockDecrease"}}'
                  {{#unless @root.canDecreaseStock}}disabled{{/unless}}>&minus;</button>
          <span class='val'>{{stock}}</span>
          <button type='button' data-popover-action='stock' data-by='1'
                  title='{{localize "TNO.Item.Overview.StockIncrease"}}'
                  aria-label='{{localize "TNO.Item.Overview.StockIncrease"}}'>+</button>
        </span>
      {{else}}
        <span class='val'>{{stock}}</span>
      {{/if}}
    </div>
  {{/if}}

  {{!-- Sits between the values and the actions, so the missing value is read
        on the way to the button that fixes it. The link only where there is an
        editor to open: the popover, for someone who may edit. --}}
  {{#if missingCount}}
    <p class='item-popover-warning' role='note'>
      <i class='fa-solid fa-circle-info' aria-hidden='true'></i>
      <span>
        <b>{{#ifEquals missingCount 1}}{{localize 'TNO.Item.Summary.MissingOne' fields=missingFields}}{{else}}{{localize 'TNO.Item.Summary.MissingMany' fields=missingFields}}{{/ifEquals}}</b>
        {{#if @root.canEdit}}
          <button type='button' class='item-popover-link' data-popover-action='edit'>{{localize 'TNO.Item.Summary.FixInEditor'}}</button>
        {{/if}}
      </span>
    </p>
  {{/if}}

  {{#if (or summary.probe summary.rows.length)}}
    <dl class='item-popover-rows'>
      {{#if summary.probe}}
        <dt>{{localize summary.probe.attribute.labelKey}}</dt>
        <dd class='{{#if summary.probe.attribute.missing}}missing{{/if}}'>{{summary.probe.attribute.display}}</dd>
        <dt>{{localize summary.probe.fv.labelKey}}</dt>
        <dd class='{{#if summary.probe.fv.missing}}missing{{/if}}'>{{summary.probe.fv.display}}</dd>
      {{/if}}
      {{#each summary.rows}}
        <dt>{{localize labelKey}}</dt>
        <dd>
          {{display}}
          {{#if note}}<span class='note {{note.state}}'>{{#ifEquals note.state 'ok'}}<i class='fa-solid fa-check' aria-hidden='true'></i>{{/ifEquals}} {{note.text}}</span>{{/if}}
        </dd>
      {{/each}}
    </dl>
  {{/if}}

  {{#if plain}}
    {{#if description}}
      <div class='item-popover-description'>{{{description}}}</div>
    {{else}}
      <p class='item-popover-description empty'>{{localize 'TNO.Item.Overview.NoDescription'}}</p>
    {{/if}}
  {{/if}}
</div>
