{{!-- The weapon's values. The primary use decides which distance question
is asked: a melee weapon has a Distanzklasse, a ranged one has its five range
bands — the wiki's ranged DK — and only the one that applies is shown. A ranged
weapon may still be swung as an improvised melee weapon under the combat rules;
that does not give it a second authored profile. --}}

<div class='gear-row' data-row='use'>
  <span class='gear-label'>{{localize 'TNO.Weapons.Use.Label'}}</span>
  <div class='gear-ctl segments' role='radiogroup' aria-label='{{localize "TNO.Weapons.Use.Label"}}'>
    {{#each useSegments}}
      <button type='button' class='use-segment' data-use='{{this.use}}' role='radio' aria-checked='{{this.on}}' tabindex='0'>
        {{localize this.label}}
      </button>
    {{/each}}
  </div>
</div>

{{!-- WA and WF together are the fixed components a weapon check starts
from, so they share one row. --}}
<div class='gear-row {{#if missing.wa}}is-missing{{/if}}{{#if missing.wf}} is-missing{{/if}}' data-row='wa'>
  <span class='gear-label' title='{{localize "TNO.Weapons.WfHint"}}'>{{localize 'TNO.Item.Editor.AttributeSkill'}}</span>
  <div class='gear-ctl gear-ctl-pair'>
    <select name='system.wa' data-field='wa' class='{{#if missing.wa}}is-missing{{/if}}'
            aria-label='{{localize "TNO.Weapons.Attribute"}}' title='{{localize "TNO.Weapons.AttributeHint"}}'>
      <option value=''>{{localize 'TNO.Item.Editor.AttributePick'}}</option>
      {{#each weaponAttributeOptions}}
        <option value='{{this.key}}' {{#if this.on}}selected{{/if}}>{{localize this.label}}</option>
      {{/each}}
    </select>
    <select name='system.wf' data-field='wf' class='{{#if missing.wf}}is-missing{{/if}}'
            aria-label='{{localize "TNO.Item.Cap.Wf"}}' title='{{localize "TNO.Weapons.WfHint"}}'>
      <option value=''>{{localize 'TNO.Item.Editor.SkillPick'}}</option>
      {{#each skills}}
        <option value='{{this.key}}' {{#ifEquals this.key ../system.wf}}selected{{/ifEquals}}>{{this.label}}</option>
      {{/each}}
    </select>
  </div>
</div>

{{#if melee}}
  <div class='gear-row {{#if missing.dk}}is-missing{{/if}}' data-row='dk'>
    <span class='gear-label' title='{{localize "TNO.Weapons.DkHint"}}'>
      {{localize 'TNO.Item.Editor.Dk'}} <span class='gear-sublabel'>· {{localize 'TNO.Item.Editor.DkSub'}}</span>
    </span>
    {{> 'systems/tno/templates/item/parts/item-scale.hbs' cells=scales.dk key='dk'}}
  </div>
{{else}}
  <div class='gear-row {{#if missing.range}}is-missing{{/if}}' data-row='range'>
    <span class='gear-label' title='{{localize "TNO.Weapons.RangeHint"}}'>{{localize 'TNO.Weapons.Range'}}</span>
    <div class='gear-ctl range-cycle' role='group' aria-label='{{localize "TNO.Weapons.Range"}}'>
      {{#each rangeFields}}
        <button type='button' class='range-band {{this.state}}' data-band='{{this.band}}' title='{{localize "TNO.Weapons.RangeCycleHint"}}'>
          <span class='range-visual' aria-hidden='true'><i></i></span>
          <strong>{{this.display}}</strong>
          <span>{{localize this.label}}</span>
        </button>
      {{/each}}
    </div>
  </div>
{{/if}}

<div class='gear-row {{#if missing.rb}}is-missing{{/if}}' data-row='rb'>
  <span class='gear-label' title='{{localize "TNO.Weapons.RbHint"}}'>{{localize 'TNO.Weapons.Rb'}}</span>
  {{> 'systems/tno/templates/item/parts/item-scale.hbs' cells=scales.rb key='rb'}}
</div>

{{!-- Which damage figure applies is decided at the table, by RB against the
armour's RH — so both are authored side by side. A ranged weapon has one
Handhabung only. --}}
<div class='gear-row {{#if missing.ss}}is-missing{{/if}}' data-row='ss'>
  <span class='gear-label' title='{{localize "TNO.Weapons.DamageHint"}}'>{{localize 'TNO.Item.Editor.DamageHandling'}}</span>
  <div class='gear-ctl gear-ctl-quad'>
    <label class='gear-field {{#if missing.ss}}is-missing{{/if}}' title='{{localize "TNO.Weapons.SsHint"}}'>
      <span class='cap'>{{localize 'TNO.Weapons.Ss'}}</span>
      <input type='number' name='system.ss.count' value='{{system.ss.count}}' min='0' step='1' />
    </label>
    <label class='gear-field' title='{{localize "TNO.Weapons.WsHint"}}'>
      <span class='cap'>{{localize 'TNO.Weapons.Ws'}}</span>
      <input type='number' name='system.ws.count' value='{{system.ws.count}}' min='0' step='1' />
    </label>
    <label class='gear-field' title='{{localize "TNO.Weapons.HhHint"}}'>
      <span class='cap'>{{#if melee}}{{localize 'TNO.Item.Editor.HhActive'}}{{else}}{{localize 'TNO.Item.Summary.Hh'}}{{/if}}</span>
      <input type='number' name='system.hh.active' value='{{system.hh.active}}' min='-3' max='3' step='1' />
    </label>
    {{#if melee}}
      <label class='gear-field' title='{{localize "TNO.Weapons.HhHint"}}'>
        <span class='cap'>{{localize 'TNO.Item.Editor.HhPassive'}}</span>
        <input type='number' name='system.hh.passive' value='{{system.hh.passive}}' min='-3' max='3' step='1' />
      </label>
    {{/if}}
  </div>
</div>
