{{!-- Armour sheet. The value set comes straight from the Rüstungen table in
the Kampfregeln: Stelle, SV, RH, RW, RA. `slots` is here too because armour
still costs Inventarslots while it is being hauled rather than worn — only
what the character wears is exempt. --}}
<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
      <div class='grid grid-2col'>
        <div class='resource'>
          <label class='resource-label'>{{localize 'TNO.Armor.Zone.Label'}}</label>
          <select name='system.zone'>
            {{#each config.armorZones as |label zone|}}
              <option value='{{zone}}'
                {{#ifEquals zone ../system.zone}}selected{{/ifEquals}}>
                {{localize label}}
              </option>
            {{/each}}
          </select>
        </div>
        <div class='resource'>
          <label class='resource-label'>{{localize 'TNO.Inventory.Slots'}}</label>
          <input
            type='text'
            name='system.slots'
            value='{{system.slots}}'
            data-dtype='Number'
            title='{{localize "TNO.Inventory.SlotsCarriedArmorHint"}}'
          />
        </div>
      </div>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>{{localize 'TNO.TabDescription'}}</a>
    <a class='item' data-tab='attributes'>{{localize 'TNO.Armor.Values'}}</a>
    <a class='item' data-tab='effects'>{{localize 'TNO.TabEffects'}}</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>

    {{! Armour Values Tab }}
    <div class='tab attributes' data-group='primary' data-tab='attributes'>
      <div class='grid grid-4col'>
        <div class='resource grid-span-1'>
          <label class='resource-label' title='{{localize "TNO.Armor.SvHint"}}'>
            {{localize 'TNO.Armor.Sv'}}
          </label>
          <input type='text' name='system.sv' value='{{system.sv}}' data-dtype='Number'/>
        </div>
        <div class='resource grid-span-1'>
          <label class='resource-label' title='{{localize "TNO.Armor.RhHint"}}'>
            {{localize 'TNO.Armor.Rh'}}
          </label>
          <input type='text' name='system.rh' value='{{system.rh}}' data-dtype='Number'/>
        </div>
        <div class='resource grid-span-1'>
          <label class='resource-label' title='{{localize "TNO.Armor.RwHint"}}'>
            {{localize 'TNO.Armor.Rw'}}
          </label>
          <input type='text' name='system.rw' value='{{system.rw}}' data-dtype='Number'/>
        </div>
        <div class='resource grid-span-1'>
          <label class='resource-label' title='{{localize "TNO.Armor.RaHint"}}'>
            {{localize 'TNO.Armor.Ra'}}
          </label>
          <input type='text' name='system.ra' value='{{system.ra}}' data-dtype='Number'/>
        </div>
      </div>

      {{!-- The Unterkleidung layers under every zone at once, and by rule
      contributes no Rüstungshärte at all, so RH on a suit is ignored. --}}
      {{#ifEquals system.zone 'suit'}}
        <p class='hint'>{{localize 'TNO.Armor.SuitNoRhHint'}}</p>
      {{/ifEquals}}
    </div>

    {{! Effects Tab }}
    <div class='tab effects' data-group='primary' data-tab='effects'>
      {{> "systems/tno/templates/item/parts/item-effects.hbs"}}
    </div>
  </section>
</form>
