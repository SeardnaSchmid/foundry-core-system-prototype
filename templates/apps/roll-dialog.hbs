{{!-- The roll dialog as a short questionnaire rather than a wall of controls.

Six sections, each headed by the question it answers, sorted strictly by
**who owns the answer**: what you bring, then what you are handed, then what
you decide. Two labelled dividers make that split visible instead of leaving
the reader to infer it, and the one question that can block the roll — the
required context — leads the middle group.

The threshold is not a section. It is the answer, so it sits last in document
order, and it is pinned, so it stays legible while the questions scroll behind
it. Watching it move as you answer is the reason this is one page and not a
wizard.

Every `name=` here is load-bearing: `_updateObject` and `_refresh` read the form
by name, so a control may be moved but never renamed. --}}

<form class="tno-roll-dialog flexcol">
  <div class="tno-roll-subject">
    <h2 class="tno-roll-subject-name">{{subject}}</h2>
  </div>

  {{!-- ① What you bring. Read-only in every combat workflow: the attribute, the
        skill rank, and the requirements your own gear imposes on you. These are
        facts about the character, which is why the weapon's Handhabung and SV
        step sit here and not down among the situational modifiers — a player
        cannot argue with them and should not have to hunt for them. --}}
  <section class="tno-roll-section tno-roll-base">
    <span class="tno-roll-section-caption">{{localize "TNO.Roll.Question.Base"}}</span>

    {{#if isSkillMode}}
    {{#if isLockedAttribute}}
    <div class="tno-roll-detail">
      <span class="tno-roll-detail-label">{{localize "TNO.Roll.AttributeA"}}</span>
      <span class="tno-roll-detail-value">{{selectedAttributeLabel}}</span>
    </div>
    <input type="hidden" name="attributeA" value="{{attributeA}}"/>
    {{else}}
    <div class="form-group tno-attribute-field">
      <label>{{localize "TNO.Roll.ChooseAttribute"}}</label>
      <div class="tno-attribute-chip-grid" role="group" aria-label="{{localize 'TNO.Roll.ChooseAttribute'}}">
        <span class="tno-attribute-col-head" aria-hidden="true">{{localize "TNO.AttributeCategory.Physical"}}</span>
        <span class="tno-attribute-col-head" aria-hidden="true">{{localize "TNO.AttributeCategory.Social"}}</span>
        <span class="tno-attribute-col-head" aria-hidden="true">{{localize "TNO.AttributeCategory.Mental"}}</span>
        {{#each attributeGrid as |row|}}
        {{#each row as |chip|}}
        <button type="button" class="tno-attribute-chip {{#if chip.active}}active{{/if}}" data-key="{{chip.key}}"
          aria-pressed="{{#if chip.active}}true{{else}}false{{/if}}"
          title="{{chip.label}}" style="background:{{chip.cellBg}}; color:{{chip.textColor}};">
          <span class="tno-attribute-chip-abbr">{{chip.abbr}}</span>
          <span class="tno-attribute-chip-value">{{chip.value}}</span>
        </button>
        {{/each}}
        {{/each}}
    </div>
    <input type="hidden" name="attributeA" value="{{attributeA}}"/>
    <div class="tno-attribute-selected"><span class="tno-attribute-selected-name">{{selectedAttributeLabel}}</span></div>
    </div>
    {{/if}}
    <div class="tno-skill-row">
      <span class="tno-skill-name">{{skillLabel}}</span>
      <span class="tno-skill-value" style="background:{{skillCellBg}}; color:{{skillTextColor}};">{{skillValue}}</span>
    </div>
    {{else if isFixedMode}}
    <div class="tno-roll-detail">
      <span class="tno-roll-detail-label">{{fixedLabel}}</span>
      <span class="tno-roll-detail-value">{{fixedValueDisplay}}</span>
    </div>
    {{else if isFreeMode}}
    <div class="form-group">
      <label>{{localize "TNO.Roll.AttributeA"}}</label>
      <select name="attributeA">
        <option value="">-</option>
        {{#each abilities as |label key|}}
        <option value="{{key}}" {{#ifEquals key ../attributeA}}selected{{/ifEquals}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group">
      <label>{{localize "TNO.Roll.FreeSkillValue"}}</label>
      <input type="number" name="skillValue" value="{{skillValue}}" min="0" max="10" step="1"/>
    </div>
    {{else if isLockedAttribute}}
    {{!-- A locked attribute outside skill mode: the workflow decided it, so it
          is read out rather than picked, and no second slot is offered — the
          roll is that one attribute plus its rule modifiers. --}}
    <div class="tno-roll-detail">
      <span class="tno-roll-detail-label">{{localize "TNO.Roll.AttributeA"}}</span>
      <span class="tno-roll-detail-value">{{selectedAttributeLabel}}</span>
    </div>
    <input type="hidden" name="attributeA" value="{{attributeA}}"/>
    {{else}}
    <div class="form-group">
      <label>{{localize "TNO.Roll.AttributeA"}}</label>
      <select name="attributeA">
        <option value="">-</option>
        {{#each abilities as |label key|}}
        <option value="{{key}}" {{#ifEquals key ../attributeA}}selected{{/ifEquals}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group">
      <label>{{localize "TNO.Roll.AttributeB"}}</label>
      <select name="attributeB">
        <option value="">-</option>
        {{#each abilities as |label key|}}
        <option value="{{key}}" {{#ifEquals key ../attributeB}}selected{{/ifEquals}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    {{/if}}

    {{!-- The requirements the character's own gear imposes: the weapon's
          Handhabung and its SV shortfall, and the repeated-defence malus the
          current Haltung has run up. Immutable here — the way to change any of
          them is to change what is worn or carried. --}}
    {{#if hasFixedModifiers}}
    <div class="tno-roll-gear-modifiers">
      {{#each fixedModifiers as |modifier|}}
      <div class="tno-roll-detail">
        <span class="tno-roll-detail-label">{{modifier.label}}</span>
        <span class="tno-roll-detail-value">{{modifier.display}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{!-- The armour SV step, which applies or not depending on the attribute
          currently chosen. Rendered once and toggled by `_refresh`, since that
          method repaints values rather than rebuilding rows. Absent entirely
          for a character who meets the requirement. --}}
    {{#if armorMalus}}
    <div class="tno-roll-detail tno-armor-malus" {{#unless armorMalus.active}}hidden{{/unless}}>
      <span class="tno-roll-detail-label">{{armorMalus.label}}</span>
      <span class="tno-roll-detail-value">{{armorMalus.display}}</span>
    </div>
    {{/if}}
  </section>

  {{#if hasGivenDivider}}
  <div class="tno-roll-divider"><span>{{localize "TNO.Roll.Divider.Given"}}</span></div>
  {{/if}}

  {{!-- ② The situation, and the only thing in this dialog that can stop the
        roll: a reach comparison, a range band, a penetration comparison, an
        announced Schadenswert. It leads because a threshold without it would be
        a lie, and because everything below it is optional. --}}
  {{#if hasSituationSection}}
  <section class="tno-roll-section tno-roll-situation">
    <span class="tno-roll-section-caption">{{localize "TNO.Roll.Question.Situation"}}</span>

    {{#if hasPreRollContext}}
    {{#if preRollContext.isTilePicker}}
    <fieldset class="tno-context-field tno-context-tile-field">
      <legend>{{preRollContext.label}}</legend>
      <div class="tno-context-tile-grid tno-context-tile-grid-{{preRollContext.tileColumns}}">
        {{#each preRollContext.choices as |choice|}}
        <input id="tno-roll-context-choice-{{choice.key}}" class="tno-context-tile-input" type="radio" name="contextChoice" value="{{choice.key}}" required {{#if choice.selected}}checked{{/if}}>
        <label class="tno-context-tile {{choice.state}} {{#if ../preRollContext.tileLabels}}has-caption{{/if}}" for="tno-roll-context-choice-{{choice.key}}" title="{{choice.label}}">
          {{!-- The slope shows the shape of a modifier ladder, which is worth a
                row of height on the five range bands and nothing at all where
                the tiles lead with meaning: two of the three penetration tiles
                are worth the same ±0, so their slopes are identical and the
                only thing separating them is the text. --}}
          {{#unless choice.headline}}
          <span class="tno-context-tile-visual" aria-hidden="true"><i></i></span>
          {{/unless}}
          <strong>{{choice.headline}}</strong>
          {{#if ../preRollContext.tileLabels}}<span class="tno-context-tile-caption">{{choice.label}}</span>{{/if}}
        </label>
        {{/each}}
      </div>
    </fieldset>
    {{else}}
    <div class="form-group tno-context-field">
      <label for="tno-roll-context-choice">{{preRollContext.label}}</label>
      <select id="tno-roll-context-choice" name="contextChoice" required>
        <option value="" disabled {{#unless contextSelected}}selected{{/unless}}>{{preRollContext.placeholder}}</option>
        {{#each preRollContext.choices as |choice|}}
        <option value="{{choice.key}}" {{#if choice.selected}}selected{{/if}}>{{choice.label}} ({{choice.display}})</option>
        {{/each}}
      </select>
    </div>
    {{/if}}
    {{/if}}

    {{!-- The label is repainted by `_refresh`: where a workflow supplies one
          per context choice, the pick above decides which number this field is
          asking for, and saying so here is the only place that connection is
          ever made. --}}
    {{#if hasRequiredValue}}
    <div class="form-group tno-required-value-field">
      <label for="tno-roll-required-value">{{requiredValue.label}}</label>
      <input id="tno-roll-required-value" type="number" name="requiredValue" step="1"
             value="{{requiredValue.value}}" placeholder="{{requiredValue.placeholder}}"
             {{#if requiredValue.hasMin}}min="{{requiredValue.min}}"{{/if}}
             {{#if requiredValue.hasMax}}max="{{requiredValue.max}}"{{/if}}
             autocomplete="off" required/>
    </div>
    {{#if requiredValue.hint}}
    <p class="tno-required-value-hint">{{requiredValue.hint}}</p>
    {{/if}}
    {{/if}}
  </section>
  {{/if}}

  {{!-- ③ What the other side declared. Its own question because it is the only
        number in the dialog that came from another player: read off their card
        or filled in by its shortcut, never computed here. Defences only.

        From here a Finte, a Starker Schwung and a Weiter Schwung are the same
        statement — one number — which is exactly why nothing on this side needs
        to know which of them it was. --}}
  {{#if hasAgainstSection}}
  <section class="tno-roll-section tno-roll-against">
    <span class="tno-roll-section-caption">{{localize "TNO.Roll.Question.Against"}}</span>

    {{#if hasOpposingAnsage}}
    <div class="form-group tno-required-value-field">
      <label for="tno-roll-opposing-ansage">{{localize "TNO.Combat.OpposingAnsage"}}</label>
      <input id="tno-roll-opposing-ansage" type="number" name="opposingAnsage" min="0" step="1"
             value="{{opposingAnsage}}" placeholder="0" autocomplete="off"/>
    </div>
    {{/if}}

    {{!-- Eine Regel, die die Gegenseite angesagt hat: der Spieler bestätigt
          sie, er rechnet sie nicht aus. --}}
    {{#if toggleModifier}}
    <div class="form-group tno-toggle-modifier">
      <label for="tno-roll-toggle-modifier" title="{{toggleModifier.hint}}">
        <input id="tno-roll-toggle-modifier" type="checkbox" name="toggleModifier" {{#if toggleModifier.checked}}checked{{/if}}>
        {{toggleModifier.label}}
        <span class="tno-toggle-modifier-value">{{toggleModifier.display}}</span>
      </label>
    </div>
    {{/if}}
  </section>
  {{/if}}

  {{#if hasChosenDivider}}
  <div class="tno-roll-divider"><span>{{localize "TNO.Roll.Divider.Chosen"}}</span></div>
  {{/if}}

  {{!-- ④ Everything the player dials in themselves. Closed by default, because
        closed *is* the standard attack: no Ansage, no modification, and the
        Torso, which is where a blow that announced nothing lands.

        The Ansagen — "Ansagen auf Trefferzonen im Nahkampf, normale Ansageregeln
        gelten hier auf alles" — share the box with the scene's ±3. The Stelle
        carries the price the rulebook writes down; the free field carries
        everything the rulebook prices at the table instead, from a Finte to a
        Schwachstelle the GM named; the stepper carries what the GM improvised on
        top of all of it. None of the three is converted or argued with here, and
        all three are the same kind of thing — a number this player is choosing —
        which is why the modification stopped standing in a box of its own where
        it read as a fixed part of the roll.

        A native `<details>`: the disclosure, its keyboard handling and its
        `open` state come from the browser. It renders open whenever the roll
        already carries something, so a re-render can never hide a value that
        was set. --}}
  {{#if hasAttemptSection}}
  <details class="tno-roll-section tno-roll-attempt" {{#if attemptOpen}}open{{/if}}>
    <summary class="tno-attempt-summary">
      <span class="tno-roll-section-caption">{{localize "TNO.Roll.Question.Attempt"}}</span>
      {{!-- What the closed block is carrying, so it never hides a cost.
            Repainted by `_refresh`. --}}
      <span class="tno-attempt-badge">{{attemptBadge}}</span>
    </summary>

    {{#if zonePicker}}
    <fieldset class="tno-context-field tno-context-tile-field tno-zone-field">
      <legend>{{zonePicker.label}}</legend>
      <div class="tno-context-tile-grid tno-context-tile-grid-4">
        {{#each zonePicker.choices as |choice|}}
        <input id="tno-roll-zone-{{choice.key}}" class="tno-context-tile-input" type="radio" name="zoneChoice" value="{{choice.key}}" {{#if choice.selected}}checked{{/if}}>
        <label class="tno-context-tile has-caption" for="tno-roll-zone-{{choice.key}}" title="{{choice.caption}}">
          <strong>{{choice.label}}</strong>
          <span class="tno-zone-tile-cost {{#unless choice.cost}}is-free{{/unless}}">{{choice.costDisplay}}</span>
          <span class="tno-context-tile-caption">{{choice.caption}}</span>
        </label>
        {{/each}}
      </div>
    </fieldset>
    {{/if}}

    {{#if hasAnsage}}
    <div class="tno-ansage-row">
      <label class="tno-ansage-name" for="tno-roll-ansage" title="{{ansage.hint}}">{{ansage.label}}</label>
      <input id="tno-roll-ansage" type="number" name="ansage" min="0" step="1"
             value="{{ansage.value}}" placeholder="0" autocomplete="off">
      <span class="tno-ansage-readout">{{ansage.display}}</span>
    </div>
    {{/if}}

    {{!-- What the scene does, which is the GM's to hand out and nobody else's.
          It used to share a box called "Modifikatoren" with the weapon's own
          requirements, which made a rule the player cannot change look like the
          same kind of thing as a number the GM improvised — so it moved out.
          Here it sits with the other numbers this player is deciding. --}}
    {{#unless isFixedMode}}
    <div class="form-group tno-bonus-field">
      <label>{{localize "TNO.Roll.Bonus"}}</label>
      <div class="tno-bonus-stepper-group flexrow flex-center">
        <button type="button" class="tno-bonus-stepper" data-action="decrement" aria-label="-3" {{#if bonusAtMin}}disabled{{/if}}>−3</button>
        <span class="tno-bonus-value {{bonusSignClass}}" role="button" tabindex="0" title="{{localize 'TNO.Roll.BonusReset'}}" aria-label="{{localize 'TNO.Roll.Bonus'}}">{{bonusDisplay}}</span>
        <button type="button" class="tno-bonus-stepper" data-action="increment" aria-label="+3" {{#if bonusAtMax}}disabled{{/if}}>+3</button>
      </div>
      <input type="hidden" name="bonus" value="{{bonus}}"/>
    </div>
    {{/unless}}
  </details>
  {{/if}}

  {{!-- ⑤ What you spend. Last of the decisions, because it is the one worth
        making only once the threshold everything else produced is visible.

        "Idee haben" is a pre-edge: only offered here, before the dice are cast.
        There is deliberately no way to apply it retroactively to a roll already
        made (see problem-solving-prd.md). --}}
  {{#if hasIdeaOption}}
  <section class="tno-roll-section tno-roll-spend">
    <span class="tno-roll-section-caption">{{localize "TNO.Roll.Question.Spend"}}</span>
    <div class="form-group tno-idea-field">
      <label class="tno-idea-toggle {{#if useIdea}}active{{/if}} {{#if ideaDisabled}}tno-idea-disabled{{/if}}"
             data-tooltip-html='<dl class="tno-tooltip">
{{#if ideaDisabled}}
<div class="tno-tooltip-row"><dt>{{localize "TNO.Roll.IdeaToggle"}}</dt><dd>{{localize "TNO.Notify.NoReserve"}}</dd></div>
{{else}}
<div class="tno-tooltip-row"><dt>{{localize "TNO.Roll.IdeaToggle"}} <span class="tno-tooltip-value">+{{insightValue}}</span></dt><dd>{{localize "TNO.DerivedHint.Insight"}}</dd></div>
<div class="tno-tooltip-row"><dd>{{localize "TNO.Notify.ProblemSolvingGate"}}</dd></div>
{{/if}}
</dl>'
             data-tooltip-direction='UP'>
        <input type="checkbox" name="useIdea" {{#if useIdea}}checked{{/if}} {{#if ideaDisabled}}disabled{{/if}}/>
        {{!-- Redundant on/off cue #1: a literal checkbox square with a
              checkmark, since the border/icon-colour shift alone read as too
              subtle to notice at a glance. --}}
        <span class="tno-idea-checkbox" aria-hidden="true"><i class="fas fa-check"></i></span>
        <i class="fas fa-lightbulb tno-idea-icon" aria-hidden="true"></i>
        <span class="tno-idea-text">{{localize "TNO.Roll.IdeaToggle"}}</span>
        <span class="tno-idea-value">+{{insightValue}}</span>
        <span class="tno-idea-reserve"
              data-tooltip-html='<dl class="tno-tooltip"><div class="tno-tooltip-row"><dt>{{localize "TNO.Roll.IdeaReserve"}} <span class="tno-tooltip-value">{{edgePool}}/{{edgePoolMax}}</span></dt></div></dl>'
              data-tooltip-direction='UP'>
          {{#if hasIdeaPips}}
          <span class="tno-idea-pips" aria-hidden="true">
            {{#each ideaPips}}<span class="tno-idea-pip {{#if this.filled}}filled{{/if}}"></span>{{/each}}
          </span>
          {{else}}
          <span class="tno-idea-reserve-text">{{localize "TNO.Roll.IdeaReserve"}} {{edgePool}}/{{edgePoolMax}}</span>
          {{/if}}
        </span>
      </label>
    </div>
  </section>
  {{/if}}

  {{!-- ⑥ How you roll it. Above the threshold box on purpose: the roll type
        leaves the threshold alone but changes the odds printed inside that box,
        so choosing it below would mean looking back up to see what it did. The
        picker's own "Wurftyp" label is hidden here and the question stands in
        its place; that label is still the right noun on the chat card, which is
        why the string was not simply reworded. The radiogroup keeps its own
        aria-label either way. --}}
  {{#unless isFixedMode}}
  <section class="tno-roll-section tno-roll-rolltype">
    <span class="tno-roll-section-caption">{{localize "TNO.Roll.Question.RollType"}}</span>
    {{> "systems/tno/templates/apps/parts/advantage-picker.hbs"}}
  </section>
  {{else}}
  <input type="hidden" name="bonus" value="{{bonus}}"/>
  <input type="hidden" name="advantage" value="{{advantage}}"/>
  {{/unless}}

  {{!-- The answer, and the commit. Pinned to the foot of the dialog so the
        number stays readable while the questions scroll behind it — every
        section above exists to move this figure, and a player who cannot see it
        move is filling in a form instead of making a decision. --}}
  <footer class="tno-roll-footer">
    <div class="tno-roll-result tno-threshold-box">
      <span class="tno-roll-result-label">{{localize "TNO.Roll.Threshold"}}</span>
      {{!-- What that threshold is actually worth, answered next to the number
            that raises the question rather than parked behind an icon. Rebuilt
            by _refresh on every threshold *and* roll-type change. --}}
      <span class="tno-roll-result-value">≤ <span class="tno-threshold-value">{{threshold}}</span>
        <span class="tno-odds tno-tooltip-hint"
              tabindex="0"
              role="img"
              aria-label="{{localize "TNO.Roll.Odds.InfoLabel"}}: {{oddsLabel}}"
              data-tooltip-html="{{oddsTooltip}}">{{oddsLabel}}</span>
      </span>
      <span class="tno-roll-breakdown">{{breakdown}}</span>
      {{!-- The same figure as a strip across the foot of the box, so the odds
            are legible before the number is read. --}}
      <span class="tno-odds-meter" aria-hidden="true"><span class="tno-odds-fill" style="width: {{oddsPercent}}%"></span></span>
    </div>

    <button type="submit" class="tno-roll-submit" {{#unless canSubmit}}disabled{{/unless}}>
      <span class="tno-roll-submit-main"><i class="fas fa-dice-d20"></i> {{localize "TNO.Roll.Submit"}}</span>
      <span class="tno-roll-submit-echo">{{targetLabel}} ≤ {{threshold}}</span>
    </button>
  </footer>
</form>
