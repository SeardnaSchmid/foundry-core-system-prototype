{{!-- The roll dialog: numbered questions above, the Schwelle below.

Only what the roller has to answer is asked ("Zu klären"). Facts — the
attribute a weapon locks, the skill rank, handling, armour — are not asked;
they live in the Beleg, the drawer that opens above the Schwelle and lists
every component grouped by where it comes from. `_refresh` fills the Beleg
and repaints everything that moves.

A question still waiting for its answer wears a dashed blue outline
(`.is-open`); one that cannot be answered yet, or no longer applies, is greyed
(`.is-locked`). While anything is open the Schwelle and odds are shown in
parentheses. Red is kept for a Δ that costs you and for the refusal a pressed
button earns: the button is `aria-disabled` rather than `disabled` so that
press can happen, and the form is `novalidate` so the browser's own bubble
cannot pre-empt it.

Every `name=` here is load-bearing: `_updateObject` reads the form by name. --}}

<form class="tno-roll-dialog tno-wurf" novalidate>
  <div class="tno-wurf-phase">
    <span class="tno-wurf-phase-caption">{{localize "TNO.Roll.Phase.Caption"}}</span>
    <strong>{{phase.label}}</strong>
    {{#if phase.detail}}<span class="tno-wurf-phase-detail">{{phase.detail}}</span>{{/if}}
  </div>

  {{#if isLockedAttribute}}<input type="hidden" name="attributeA" value="{{attributeA}}"/>{{/if}}
  {{#if isFixedMode}}<input type="hidden" name="bonus" value="{{bonus}}"/>{{/if}}

  {{#if hasQuestions}}
  <section class="tno-wurf-questions">
    <h3 class="tno-wurf-caption">{{localize "TNO.Roll.ToClarify"}}</h3>

    {{#each questions as |q|}}
    <div class="tno-q {{#if q.open}}is-open{{/if}} {{#if q.locked}}is-locked{{/if}}" data-q="{{q.key}}">
      <div class="tno-q-head">
        <div class="tno-q-text">
          {{#if q.ask}}<div class="tno-q-ask" data-role="q-ask" {{#if q.locked}}hidden{{/if}}>{{q.ask}}</div>{{/if}}
          <div class="tno-q-title">
            <span data-role="q-title">{{q.num}} · {{q.title}}</span>
            {{#if q.info}}
            <button type="button" class="tno-q-info" tabindex="-1" data-tooltip="{{q.info}}" data-tooltip-direction="UP"
                    aria-label="{{localize 'TNO.Roll.Ledger.InfoLabel'}}"><i class="fa-solid fa-circle-info" aria-hidden="true"></i></button>
            {{/if}}
          </div>
          <div class="tno-q-sub" data-role="q-sub">{{q.sub}}</div>
          {{#if q.isIdea}}
          <div class="tno-idea-pool">
            <span class="tno-idea-pips" aria-hidden="true">{{#each q.pips}}<span class="tno-idea-pip {{#if this.filled}}filled{{/if}}"></span>{{/each}}</span>
            <span data-role="idea-charges">{{q.chargesText}}</span>
          </div>
          {{/if}}
        </div>

        {{!-- Controls that fit beside the question. --}}
        {{#if q.meta}}<div class="tno-q-meta">{{q.meta}}</div>{{/if}}

        {{#if q.isRequired}}
        <span class="tno-stepper">
          <button type="button" class="tno-step" data-step="-1" aria-label="{{localize 'TNO.Roll.ValueDecrease'}}">&minus;</button>
          <input type="number" name="requiredValue" step="1" value="{{q.value}}" aria-label="{{q.title}}"
                 {{#if q.hasMin}}min="{{q.min}}"{{/if}} {{#if q.hasMax}}max="{{q.max}}"{{/if}}
                 {{#if q.locked}}disabled{{/if}} autocomplete="off"/>
          <button type="button" class="tno-step" data-step="1" aria-label="{{localize 'TNO.Roll.ValueIncrease'}}">+</button>
        </span>
        {{/if}}

        {{#if q.isFree}}
        <span class="tno-stepper">
          <button type="button" class="tno-step" data-step="-1" aria-label="{{localize 'TNO.Roll.ValueDecrease'}}">&minus;</button>
          <input type="number" name="skillValue" step="1" value="{{q.value}}" min="{{q.min}}" max="{{q.max}}" aria-label="{{q.title}}" autocomplete="off"/>
          <button type="button" class="tno-step" data-step="1" aria-label="{{localize 'TNO.Roll.ValueIncrease'}}">+</button>
        </span>
        {{/if}}

        {{#if q.isAttributeB}}
        <select name="attributeB" aria-label="{{q.title}}">
          <option value="">–</option>
          {{#each q.options as |ability|}}
          <option value="{{ability.key}}" {{#if ability.selected}}selected{{/if}}>{{ability.label}} {{ability.value}}</option>
          {{/each}}
        </select>
        {{/if}}

        {{#if q.isBonus}}
        <span class="tno-bonus-stepper">
          {{#each q.steps as |s|}}{{#if s.left}}
          <button type="button" class="tno-bonus-step {{#if s.fine}}is-fine{{/if}}" data-delta="{{s.step}}" aria-label="{{s.aria}}" {{#if s.disabled}}disabled{{/if}}>{{s.label}}</button>
          {{/if}}{{/each}}
          <button type="button" class="tno-bonus-value {{q.signClass}}" title="{{localize 'TNO.Roll.BonusReset'}}" aria-label="{{q.resetLabel}}">{{q.display}}</button>
          {{#each q.steps as |s|}}{{#unless s.left}}
          <button type="button" class="tno-bonus-step {{#if s.fine}}is-fine{{/if}}" data-delta="{{s.step}}" aria-label="{{s.aria}}" {{#if s.disabled}}disabled{{/if}}>{{s.label}}</button>
          {{/unless}}{{/each}}
        </span>
        <input type="hidden" name="bonus" value="{{../bonus}}"/>
        {{/if}}

        {{#if q.isAnsage}}
        <div class="tno-ansage-control">
          <span class="tno-stepper">
            <button type="button" class="tno-step" data-step="-1" aria-label="{{localize 'TNO.Roll.ValueDecrease'}}">&minus;</button>
            <input id="{{../dialogId}}-ansage" type="number" name="ansage" step="1" value="{{q.value}}"
                   aria-label="{{q.title}}" autocomplete="off"/>
            <button type="button" class="tno-step" data-step="1" aria-label="{{localize 'TNO.Roll.ValueIncrease'}}">+</button>
          </span>
          <span class="tno-ansage-delta {{q.delta.cls}}" data-role="ansage-delta">{{q.delta.display}}</span>
        </div>
        {{/if}}

        {{#if q.isIdea}}
        <button type="button" class="tno-q-idea-toggle" aria-pressed="{{#if q.checked}}true{{else}}false{{/if}}"
                aria-label="{{q.title}}" {{#if q.disabled}}disabled{{/if}}>{{q.insight}}</button>
        <input type="checkbox" name="useIdea" {{#if q.checked}}checked{{/if}} hidden/>
        {{/if}}
      </div>

      {{!-- Controls that take the full width under the question. --}}
      {{#if q.isToggle}}
      <div class="tno-choice-grid tno-choice-grid-2">
        <button type="button" class="tno-choice tno-q-bool" data-value="0" aria-pressed="{{#if q.checked}}false{{else}}true{{/if}}">{{q.noLabel}}</button>
        <button type="button" class="tno-choice tno-q-bool" data-value="1" aria-pressed="{{#if q.checked}}true{{else}}false{{/if}}">{{q.yesLabel}}</button>
      </div>
      <input type="checkbox" name="toggleModifier" {{#if q.checked}}checked{{/if}} hidden/>
      {{/if}}

      {{#if q.isTiles}}
      <div class="tno-choice-grid tno-choice-grid-{{q.columns}}" role="radiogroup" aria-label="{{q.title}}">
        {{#each q.choices as |choice|}}
        <input id="{{../../dialogId}}-context-{{choice.key}}" class="tno-choice-input" type="radio" name="contextChoice" value="{{choice.key}}" required {{#if choice.selected}}checked{{/if}}>
        <label class="tno-choice" for="{{../../dialogId}}-context-{{choice.key}}" title="{{#if choice.caption}}{{choice.caption}}{{else}}{{choice.name}}{{/if}}">
          <strong>{{choice.name}} <span class="tno-choice-delta is-{{choice.state}}">{{choice.display}}</span></strong>
          {{#if choice.caption}}<small>{{choice.caption}}</small>{{/if}}
        </label>
        {{/each}}
      </div>
      {{/if}}

      {{#if q.isSelect}}
      <select name="contextChoice" required aria-label="{{q.title}}">
        <option value="" disabled {{#if q.open}}selected{{/if}}>{{q.placeholder}}</option>
        {{#each q.choices as |choice|}}
        <option value="{{choice.key}}" {{#if choice.selected}}selected{{/if}}>{{choice.name}} ({{choice.display}})</option>
        {{/each}}
      </select>
      {{/if}}

      {{#if q.isCompare}}
      <div class="tno-compare">
        <div class="tno-compare-entry">
          <span>{{q.compare.label}}</span>
          <span class="tno-stepper">
            <button type="button" class="tno-step" data-step="-1" aria-label="{{localize 'TNO.Roll.ValueDecrease'}}">&minus;</button>
            <input type="number" name="compareValue" step="1" min="0" value="{{q.compare.value}}" placeholder="?"
                   aria-label="{{q.compare.label}}" {{#if q.locked}}disabled{{/if}} autocomplete="off"/>
            <button type="button" class="tno-step" data-step="1" aria-label="{{localize 'TNO.Roll.ValueIncrease'}}">+</button>
          </span>
        </div>
        <div class="tno-compare-anchor">
          <span>{{q.compare.anchorLabel}}</span>
          <strong>{{q.compare.anchor}}</strong>
        </div>
      </div>
      <div class="tno-choice-grid tno-choice-grid-3">
        {{#each q.choices as |choice|}}
        <div class="tno-verdict {{#if choice.selected}}is-selected{{/if}}" data-key="{{choice.key}}">
          <span class="tno-verdict-head"><span>{{choice.name}}</span><span class="tno-choice-delta is-{{choice.state}}">{{choice.display}}</span></span>
          <small>{{choice.caption}}</small>
        </div>
        {{/each}}
      </div>
      {{/if}}

      {{#if q.isAttribute}}
      <div class="tno-attribute-grid" role="radiogroup" aria-label="{{q.title}}">
        {{#each q.columns as |column|}}
        <div class="tno-attribute-column">
          <span class="tno-attribute-column-head" aria-hidden="true">{{column.label}}</span>
          {{#each column.items as |chip|}}
          <button type="button" class="tno-choice tno-attribute-chip {{#if chip.active}}active{{/if}}" data-value="{{chip.key}}"
                  role="radio" aria-checked="{{#if chip.active}}true{{else}}false{{/if}}" tabindex="{{#if chip.active}}0{{else}}-1{{/if}}"
                  title="{{chip.label}}" aria-label="{{chip.label}} {{chip.value}}">
            <strong>{{chip.abbr}}</strong>
            <span class="tno-attribute-chip-value">{{chip.value}}</span>
          </button>
          {{/each}}
        </div>
        {{/each}}
      </div>
      <input type="hidden" name="attributeA" value="{{q.value}}"/>
      {{/if}}

    </div>
    {{/each}}
  </section>
  {{/if}}

  {{!-- The Schwelle, with the Beleg drawer that opens over the questions. --}}
  <div class="tno-beleg">
    <div class="tno-beleg-drawer">
      <div class="tno-beleg-drawer-head" aria-hidden="true">
        <span>{{localize "TNO.Roll.Beleg.Head"}}</span>
        <span>{{localize "TNO.Roll.Ledger.Delta"}}</span>
      </div>
      <div data-role="beleg-groups"></div>
    </div>

    <div class="tno-wurf-card">
      <button type="button" class="tno-beleg-toggle" aria-expanded="false">
        <span class="tno-beleg-toggle-head">
          <span><strong>{{localize "TNO.Roll.Beleg.Title"}}</strong> · {{localize "TNO.Roll.Beleg.Caption"}}</span>
          <span class="tno-beleg-toggle-action">
            <span data-role="beleg-toggle-label">{{localize "TNO.Roll.Beleg.Open"}}</span>
            <i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
          </span>
        </span>
        <span class="tno-beleg-chips" data-role="beleg-chips"></span>
      </button>

      <div class="tno-wurf-result {{#unless ready}}is-pending{{/unless}}" aria-live="polite">
        <div class="tno-wurf-threshold">
          <span class="tno-wurf-caption">{{localize "TNO.Roll.Threshold"}}</span>
          <span class="tno-wurf-threshold-value" data-role="threshold">{{thresholdDisplay}}</span>
        </div>
        <div class="tno-wurf-odds">
          <div class="tno-wurf-odds-line">
            <span data-role="mode-label">{{modeLabel}}</span>
            <span class="tno-odds" data-role="odds" {{#if ready}}tabindex="0" data-tooltip-html="{{oddsTooltip}}"{{/if}}
                  aria-label="{{localize 'TNO.Roll.Odds.InfoLabel'}}">{{oddsLabel}}</span>
          </div>
          <span class="tno-odds-meter" aria-hidden="true"><span class="tno-odds-fill" style="width: {{oddsPercent}}%"></span></span>
          {{#unless isFixedMode}}
          <div class="tno-advantage-group" role="radiogroup" aria-label="{{localize 'TNO.Roll.Advantage'}}">
            {{#each advantageOptions as |option|}}
            <button type="button" class="tno-wurf-mode {{#if option.active}}active{{/if}}" role="radio"
                    aria-checked="{{#if option.active}}true{{else}}false{{/if}}" tabindex="{{#if option.active}}0{{else}}-1{{/if}}"
                    data-value="{{option.value}}" title="{{option.label}}" aria-label="{{option.label}}">{{option.glyph}}</button>
            {{/each}}
          </div>
          {{/unless}}
          <input type="hidden" name="advantage" value="{{advantage}}"/>
        </div>
      </div>

      <div class="tno-wurf-todo {{#unless ready}}is-open{{/unless}}" data-role="todo">{{todo}}</div>

      <button type="submit" class="tno-roll-submit {{#unless ready}}is-blocked{{/unless}}" {{#unless ready}}aria-disabled="true"{{/unless}}>
        <span class="tno-roll-submit-main"><i class="fas fa-dice-d20"></i> {{localize "TNO.Roll.Submit"}}</span>
        <span class="tno-roll-submit-echo" data-role="submit-echo"></span>
      </button>
    </div>
  </div>
</form>
