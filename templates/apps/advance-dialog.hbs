<div class="tno-advance-dialog">

  {{!-- Rank step and progress toward it: the bar, the XP invested over the
  cost of that step, and what is still missing. At max rank the bar is full
  and only the note stays. --}}
  <div class="advance-head">
    {{#if atMax}}
      <span class="advance-rank">{{localize "TNO.AdvanceMaxRank"}}</span>
    {{else}}
      <span class="advance-rank">{{localize "TNO.SkillRankLabel"}} {{rank}} <span class="advance-arrow">→</span> {{nextRank}}</span>
    {{/if}}
  </div>

  <div class="advance-progress">
    <div class="advance-bar">
      <div class="advance-bar-fill{{#if canBuy}} ready{{/if}}" style="width: {{percent}}%;"></div>
    </div>
    {{#unless atMax}}
      <div class="advance-progress-text">
        <span><b>{{xp}}</b> / {{cost}} {{localize "TNO.AdvanceInvested"}}</span>
        <span class="advance-remaining">{{#if canBuy}}{{localize "TNO.AdvanceReady"}}{{else}}{{localize "TNO.AdvanceRemaining" n=remaining}}{{/if}}</span>
      </div>
    {{/unless}}
  </div>

  {{!-- Guided actions apply immediately to the actor (no pending state):
  the stepper spends or takes back one XP (Shift: five), the main button buys
  the next rank once enough XP is invested. Buying consumes that rank's cost;
  any surplus carries over toward the following rank. --}}
  {{#unless atMax}}
    <div class="advance-actions">
      <div class="advance-stepper">
        <button type="button" data-action="xpDec" {{#unless canDecXp}}disabled{{/unless}}
                aria-label="{{localize 'TNO.AdvanceXpDecHint'}}" title="{{localize 'TNO.AdvanceXpDecHint'}}">−</button>
        <span class="advance-step">1 XP</span>
        <button type="button" data-action="xpInc"
                aria-label="{{localize 'TNO.AdvanceXpIncHint'}}" title="{{localize 'TNO.AdvanceXpIncHint'}}">+</button>
      </div>
      <button type="button" class="advance-buy" data-action="buy" {{#unless canBuy}}disabled{{/unless}} title="{{localize 'TNO.AdvanceBuyHint'}}">
        {{localize "TNO.AdvanceBuyRank" rank=nextRank cost=cost}}
      </button>
    </div>
    {{#unless canBuy}}
      <p class="advance-need">{{localize "TNO.AdvanceNeedHint" n=remaining rank=nextRank}}</p>
    {{/unless}}
  {{/unless}}

  {{!-- Correction, always at hand: rank and XP set directly, no XP booked.
  The steppers only change the fields; Übernehmen saves them. --}}
  <div class="advance-correction">
    <div class="advance-correction-head">
      <span class="advance-correction-title">{{localize "TNO.AdvanceCorrection"}}</span>
      <span>{{localize "TNO.AdvanceCorrectionNoXp"}}</span>
    </div>
    <div class="advance-correction-row">
      <div class="advance-field">
        <button type="button" data-action="step" data-field="rank" data-delta="-1" aria-label="{{localize 'TNO.AdvanceCorrectionRankLabel'}} −1">−</button>
        <label>
          <span>{{localize "TNO.AdvanceCorrectionRankLabel"}}</span>
          <input type="number" name="rank" value="{{rank}}" autocomplete="off" min="{{rankMin}}" max="10"/>
        </label>
        <button type="button" data-action="step" data-field="rank" data-delta="1" aria-label="{{localize 'TNO.AdvanceCorrectionRankLabel'}} +1">+</button>
      </div>
      <div class="advance-field">
        <button type="button" data-action="step" data-field="xp" data-delta="-1" aria-label="{{localize 'TNO.AdvanceCorrectionXpLabel'}} −1">−</button>
        <label>
          <span>{{localize "TNO.AdvanceCorrectionXpLabel"}}</span>
          <input type="number" name="xp" value="{{xp}}" autocomplete="off" min="0"/>
        </label>
        <button type="button" data-action="step" data-field="xp" data-delta="1" aria-label="{{localize 'TNO.AdvanceCorrectionXpLabel'}} +1">+</button>
      </div>
      <button type="submit" class="advance-apply">{{localize "TNO.AdvanceApply"}}</button>
    </div>
  </div>

  <footer class="advance-footer">
    <span class="advance-note">{{localize "TNO.AdvanceKeepNote"}}</span>
  </footer>
</div>
